{
  "$comment": "MB-31 B0a oracle vectors (C2, B3): Layer 3 value algebra — arith, min/max, integer application and three-valued compare over plain value objects.",
  "cases": [
    { "name": "area × storeys is an area", "fn": "arith", "args": ["×", { "k": "num", "v": 10, "u": "m2", "flags": [] }, { "k": "num", "v": 3, "u": "storeys", "flags": [] }], "want": { "k": "num", "v": 30, "u": "m2" } },
    { "name": "a percentage scales an area", "fn": "arith", "args": ["×", { "k": "num", "v": 33, "u": "pct", "flags": [] }, { "k": "num", "v": 600, "u": "m2", "flags": [] }], "want": { "k": "num", "v": 198, "u": "m2" } },
    { "name": "unregulated passes through and keeps its clause", "fn": "arith", "args": ["+", { "k": "unregulated", "clause": "c1", "flags": [] }, { "k": "num", "v": 1, "u": "m", "flags": [] }], "want": { "k": "unregulated", "clause": "c1" } },
    { "name": "unlimited passes through and keeps its clause", "fn": "arith", "args": ["×", { "k": "unlimited", "clause": "c2", "flags": [] }, { "k": "num", "v": 600, "u": "m2", "flags": [] }], "want": { "k": "unlimited", "clause": "c2" } },
    { "name": "not_buildable dominates a subtraction", "fn": "arith", "args": ["−", { "k": "nb", "clauses": ["a"], "flags": [] }, { "k": "ne", "reason": "r", "undecided": [], "flags": [] }], "want": { "k": "nb", "clauses": ["a"] } },
    { "name": "two not_evaluated add their undecided lists", "fn": "arith", "args": ["+", { "k": "ne", "reason": "r1", "undecided": [{ "id": "", "reason": "r1" }], "flags": [] }, { "k": "ne", "reason": "r2", "undecided": [{ "id": "", "reason": "r2" }], "flags": [] }], "want": { "k": "ne", "reason": "r1", "undecided": [{ "id": "", "reason": "r1" }, { "id": "", "reason": "r2" }] } },
    { "name": "an absent optional target is a missing input", "fn": "arith", "args": ["+", { "k": "absent", "id": "gfa_m2", "flags": [] }, { "k": "num", "v": 1, "u": "m2", "flags": [] }], "want": { "k": "ne", "reason": "missing_input:absent_target" } },
    { "name": "incompatible units are a unit mismatch", "fn": "arith", "args": ["+", { "k": "num", "v": 1, "u": "m", "flags": [] }, { "k": "num", "v": 1, "u": "m2", "flags": [] }], "want": { "k": "ne", "reason": "expression_error:unit_mismatch" } },
    { "name": "division by zero is refused", "fn": "arith", "args": ["÷", { "k": "num", "v": 1, "u": "m", "flags": [] }, { "k": "num", "v": 0, "u": "m", "flags": [] }], "want": { "k": "ne", "reason": "division_by_zero" } },
    { "name": "flags are unioned and sorted", "fn": "arith", "args": ["+", { "k": "num", "v": 1, "u": "m", "flags": ["b"] }, { "k": "num", "v": 2, "u": "m", "flags": ["a"] }], "want": { "k": "num", "v": 3, "u": "m", "flags": ["a", "b"] } },
    { "name": "min of a number and unregulated is the number", "fn": "minMax", "args": ["min", [{ "k": "num", "v": 300, "u": "m2", "flags": [] }, { "k": "unregulated", "clause": "c1", "flags": [] }]], "want": { "k": "num", "v": 300, "u": "m2" } },
    { "name": "min of two unregulated is the first", "fn": "minMax", "args": ["min", [{ "k": "unregulated", "clause": "c1", "flags": [] }, { "k": "unregulated", "clause": "c2", "flags": [] }]], "want": { "k": "unregulated", "clause": "c1" } },
    { "name": "min of unlimited and unregulated is unlimited", "fn": "minMax", "args": ["min", [{ "k": "unlimited", "clause": "c1", "flags": [] }, { "k": "unregulated", "clause": "c2", "flags": [] }]], "want": { "k": "unlimited", "clause": "c1" } },
    { "name": "min drops an absent argument", "fn": "minMax", "args": ["min", [{ "k": "num", "v": 300, "u": "m2", "flags": [] }, { "k": "absent", "id": "gfa_m2", "flags": [] }]], "want": { "k": "num", "v": 300, "u": "m2" } },
    { "name": "min keeps a not_evaluated reason", "fn": "minMax", "args": ["min", [{ "k": "num", "v": 300, "u": "m2", "flags": [] }, { "k": "ne", "reason": "no_candidate", "undecided": [{ "id": "", "reason": "no_candidate" }], "flags": [] }]], "want": { "k": "ne", "reason": "no_candidate" } },
    { "name": "min lets not_buildable dominate", "fn": "minMax", "args": ["min", [{ "k": "num", "v": 5, "u": "m", "flags": [] }, { "k": "nb", "clauses": ["a"], "flags": [] }]], "want": { "k": "nb", "clauses": ["a"] } },
    { "name": "min prefers not_buildable over not_evaluated", "fn": "minMax", "args": ["min", [{ "k": "ne", "reason": "r1", "undecided": [{ "id": "", "reason": "r1" }], "flags": [] }, { "k": "nb", "clauses": ["a"], "flags": [] }]], "want": { "k": "nb", "clauses": ["a"] } },
    { "name": "max of a number and unlimited is unlimited", "fn": "minMax", "args": ["max", [{ "k": "num", "v": 5, "u": "m", "flags": [] }, { "k": "unlimited", "clause": "c1", "flags": [] }]], "want": { "k": "unlimited", "clause": "c1" } },
    { "name": "max drops not_buildable unless every argument is", "fn": "minMax", "args": ["max", [{ "k": "num", "v": 5, "u": "m", "flags": [] }, { "k": "nb", "clauses": ["a"], "flags": [] }]], "want": { "k": "num", "v": 5, "u": "m" } },
    { "name": "max of only not_buildable unions the clauses", "fn": "minMax", "args": ["max", [{ "k": "nb", "clauses": ["a"], "flags": [] }, { "k": "nb", "clauses": ["b"], "flags": [] }]], "want": { "k": "nb", "clauses": ["a", "b"] } },
    { "name": "min unions the flags of every argument", "fn": "minMax", "args": ["min", [{ "k": "num", "v": 3, "u": "m", "flags": ["f1"] }, { "k": "num", "v": 4, "u": "m", "flags": ["f2"] }]], "want": { "k": "num", "v": 3, "flags": ["f1", "f2"] } },
    { "name": "floor of a near-integer ratio rounds to a count", "fn": "applyInt", "args": ["floor", { "k": "num", "v": 2.9999999999999996, "u": "ratio", "flags": [] }], "want": { "k": "num", "v": 3, "u": "count" } },
    { "name": "floor of a true fraction ratio", "fn": "applyInt", "args": ["floor", { "k": "num", "v": 2.9996, "u": "ratio", "flags": [] }], "want": { "k": "num", "v": 2, "u": "count" } },
    { "name": "ceil keeps a length unit", "fn": "applyInt", "args": ["ceil", { "k": "num", "v": 2.1, "u": "m", "flags": [] }], "want": { "k": "num", "v": 3, "u": "m" } },
    { "name": "floor passes unlimited through", "fn": "applyInt", "args": ["floor", { "k": "unlimited", "clause": "c1", "flags": [] }], "want": { "k": "unlimited", "clause": "c1" } },
    { "name": "≥ is true at equality", "fn": "compare", "args": ["≥", { "k": "num", "v": 1, "u": "units", "flags": [] }, { "k": "num", "v": 1, "u": "units", "flags": [] }], "want": true },
    { "name": "= is true at equality", "fn": "compare", "args": ["=", { "k": "num", "v": 2, "u": "units", "flags": [] }, { "k": "num", "v": 2, "u": "units", "flags": [] }], "want": true },
    { "name": "< is false above", "fn": "compare", "args": ["<", { "k": "num", "v": 2, "u": "units", "flags": [] }, { "k": "num", "v": 1, "u": "units", "flags": [] }], "want": false },
    { "name": "< across units is a unit mismatch", "fn": "compare", "args": ["<", { "k": "num", "v": 1, "u": "m", "flags": [] }, { "k": "num", "v": 1, "u": "m2", "flags": [] }], "want": { "k": "ne", "reason": "expression_error:unit_mismatch" } },
    { "name": "≥ unlimited is a condition unknown", "fn": "compare", "args": ["≥", { "k": "unlimited", "clause": "c1", "flags": [] }, { "k": "num", "v": 1, "u": "m", "flags": [] }], "want": { "k": "ne", "reason": "condition_unknown:unlimited_or_unregulated_in_comparison" } },
    { "name": "≥ a not_evaluated operand returns it", "fn": "compare", "args": ["≥", { "k": "ne", "reason": "r1", "undecided": [{ "id": "", "reason": "r1" }], "flags": [] }, { "k": "num", "v": 1, "u": "m", "flags": [] }], "want": { "k": "ne", "reason": "r1" } },
    { "name": "a count equals a storeys count", "fn": "compare", "args": ["=", { "k": "num", "v": 3, "u": "count", "flags": [] }, { "k": "num", "v": 3, "u": "storeys", "flags": [] }], "want": true }
  ]
}
