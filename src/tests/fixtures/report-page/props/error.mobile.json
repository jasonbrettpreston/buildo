{
  "harness": "MF-48 mobile props golden",
  "spec": "docs/specs/02-web-admin/126_maxbld_surface_standard.md 11b.2",
  "surface": "mobile_parcel_detail",
  "state": "error",
  "target": "mobile",
  "lifecycle": "error",
  "props": {
    "component": "View",
    "props": {
      "key": "report-lifecycle",
      "testID": "report-error",
      "className": "flex-1 items-center justify-center gap-[12px] bg-report-page px-[16px] py-[56px]"
    },
    "children": [
      {
        "component": "Text",
        "props": {
          "key": "message",
          "className": "text-center text-[16px] leading-[24px] font-normal text-report-muted",
          "accessibilityRole": "text"
        },
        "children": [
          {
            "content": "states.lifecycle.error"
          }
        ]
      },
      {
        "component": "Button",
        "props": {
          "key": "retry",
          "testID": "report-retry",
          "className": "min-h-[44px] rounded-[12px] border border-report-line bg-transparent px-[18px] h-auto shadow-none opacity-100 active:bg-report-line",
          "accessibilityRole": "button",
          "onPress": {
            "action": "retry"
          }
        },
        "children": [
          {
            "component": "Text",
            "props": {
              "key": "retry-label",
              "className": "text-[15px] leading-[20px] font-semibold text-report-ink"
            },
            "children": [
              {
                "content": "retry.text"
              }
            ]
          }
        ]
      }
    ]
  }
}
