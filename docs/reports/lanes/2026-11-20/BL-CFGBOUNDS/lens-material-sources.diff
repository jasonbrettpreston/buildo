@@ -28,0 +31,17 @@ const CONFIG_KEYS = ['debounce_ms', 'min_query_len', 'continue_wait_ms', 'entitl
+/**
+ * FIX.CONFIG-BOUNDS (task-395; Spec 128 Rule 3): the problem lines of a config against its bounds: a number with no bounds entry, an entry that is not
+ * min <= max with on_invalid fail or clamp, a value outside its bounds. [] when clean. The schema refuses the first and the shape (SV-DESC); this is the value
+ * check, run at generate time, so a slice is never emitted holding a number outside its own declared bounds.
+ */
+export function configBoundsProblems(config, bounds) {
+  const out = [];
+  for (const [k, v] of Object.entries(config)) {
+    if (typeof v !== 'number') continue;
+    const b = bounds?.[k];
+    if (b === undefined) { out.push(`config.${k}: no bounds entry`); continue; }
+    if (!(typeof b.min === 'number' && typeof b.max === 'number' && b.min <= b.max) || !(b.on_invalid === 'fail' || b.on_invalid === 'clamp')) { out.push(`config.${k}: bounds must be min <= max with on_invalid fail or clamp`); continue; }
+    if (v < b.min || v > b.max) out.push(`config.${k}: ${v} is outside its bounds ${b.min} to ${b.max}`);
+  }
+  return out;
+}
+
