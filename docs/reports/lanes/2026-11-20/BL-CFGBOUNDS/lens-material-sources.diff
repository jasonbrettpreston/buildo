+    const problems = configBoundsProblems(config, d.config?.bounds);
+    if (problems.length > 0) throw new Error(`emit-mobile-surfaces: ${id}: ${problems.join('; ')}`);
+    const bounds = Object.fromEntries(Object.keys(config).map((k) => [k, d.config.bounds[k]]));
+    const slice = { surface: id, config, ...(Object.keys(bounds).length > 0 ? { bounds } : {}), content };
