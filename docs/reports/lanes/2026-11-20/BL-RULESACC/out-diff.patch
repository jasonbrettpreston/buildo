{+    expect(t370).toMatch(/orchestrator reading/i);+}
{+    const t348 = taskFile(348);+}
{+    expect(t348).toMatch(/^status: DONE$/m);+}
{+    expect(t348).toMatch(/RR-03\d\d/);+}
