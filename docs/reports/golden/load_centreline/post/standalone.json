            "source": "check",
            "order_guarantee": {
              "anchor": "L8 abort-before-DELETE if invalid >5%",
              "guarantee": "Spec 62 §3.5 makes > 5% unrepairable geometry an ABORT: FAIL the run and return BEFORE entering pipeline.withTransaction, so no transaction state can dangle and the pre-existing toronto_centreline is preserved untouched. This check is scored at when:pre_write for exactly that reason — a FAIL row here with no active override skips the write entirely (no transaction is opened)."
            }
          },
          {
            "metric": "f_c1_empty_temp_guard_fired_first_run",
            "value": false,
