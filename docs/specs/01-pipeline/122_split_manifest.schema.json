{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "122_split_manifest.schema.json",
  "title": "Spec 122/123/124 split-move manifest",
  "description": "Declared data consumed by scripts/analysis/spec-split-check.mjs (Spec 124 §4 R-I(4); Spec 122 §10.3). --refresh is the only sanctioned writer of moves[].content_sha256/moved_at/commit.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "budgets", "reader_guards", "known_dangling", "moves"],
  "properties": {
    "contract_version": { "const": 1 },
    "budgets": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/budget" },
      "minProperties": 1
    },
    "reader_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reader", "slices"],
        "properties": {
          "reader": { "type": "string", "minLength": 1 },
          "slices": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "reader_literal": { "type": "string", "minLength": 1 },
          "checks_spec_files": { "type": "boolean" }
        }
      }
    },
    "known_dangling": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["citation", "sites", "why", "owner", "declared"],
        "properties": {
          "citation": { "type": "string", "minLength": 1 },
          "sites": { "type": "integer", "minimum": 1 },
          "why": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "declared": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "moves": {
      "type": "array",
      "items": { "$ref": "#/definitions/move" }
    }
  },
  "definitions": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headroom_pct", "measured_at"],
      "properties": {
        "headroom_pct": { "type": "number", "minimum": 0 },
        "measured_at": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines", "bytes", "commit"],
          "properties": {
            "lines": { "type": "integer", "minimum": 1 },
            "bytes": { "type": "integer", "minimum": 1 },
            "commit": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_spec", "anchor", "to_spec", "to_anchor", "line_count", "classification", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^(M[0-9]+[a-z]?|G-A[0-9]+)$" },
        "from_spec": { "enum": ["122", "123", "124"] },
        "anchor": { "type": "string", "minLength": 1 },
        "to_spec": { "type": "string", "minLength": 1 },
        "to_anchor": { "type": "string", "minLength": 1 },
        "content_sha256": { "type": ["string", "null"], "pattern": "^([0-9a-f]{64})?$" },
        "line_count": { "type": "integer", "minimum": 1 },
        "moved_at": { "type": ["string", "null"] },
        "commit": { "type": ["string", "null"] },
        "classification": { "enum": ["HISTORICAL", "GRANDFATHERED"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
