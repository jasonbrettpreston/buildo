# Database (Cloud SQL PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/buildo

# Or individual credentials:
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=buildo
# PG_USER=postgres
# PG_PASSWORD=

# Google Maps Platform
GOOGLE_MAPS_API_KEY=
# Client-side Google Maps key (for Street View, Maps embeds)
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# SendGrid (email notifications)
SENDGRID_API_KEY=

# Dev mode — set to "true" to bypass auth (local development only)
NEXT_PUBLIC_DEV_MODE=true

# Firebase (auth + push)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=

# Serper.dev (web search for builder enrichment)
SERPER_API_KEY=

# Stripe (payments - Phase 4)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# PostHog telemetry (public by design — project-scoped key)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# GCS Database Backup (scripts/backup-db.js — spec 112)
# Required in production; leave empty locally to skip backup step.
BACKUP_GCS_BUCKET=

# --- Admin plane (P1-F4 shakeout additions, 2026-07-19) ---

# CSRF origin allowlist for admin mutations (Spec 33 §13, verify-admin.ts).
# DEFAULT-DENY: when unset/empty, every state-mutating admin request (POST/
# PATCH/PUT/DELETE) fails the Origin check and returns 401 — set this before
# expecting any admin mutation to work. Comma-separated canonical origins.
ADMIN_ALLOWED_ORIGINS=http://localhost:3000

# MFA enforcement gate for admin routes (verify-admin.ts, Spec 13 §3.6/§4a).
# KEEP false until the break-glass path (backup codes + bootstrap admin) has
# been proven end-to-end on a real device — flipping this on first is the
# MFA-lockout failure mode Spec 13 §4a names explicitly (P1-F4 sequencing).
ADMIN_MFA_ENFORCED=false

# CI/pipeline admin credential (Spec 13 §3.7 successor to ADMIN_API_KEY).
# Sent as the `x-admin-key` header; verified ONLY in verify-admin.ts
# (middleware does a presence-only passthrough, never the comparison).
# CI_ADMIN_ALLOWED_IPS: comma-separated caller IPs; the token only grants
# admin_key auth when the caller IP is in this list (fails closed).
CI_ADMIN_TOKEN=
CI_ADMIN_ALLOWED_IPS=127.0.0.1

# First-admin bootstrap (migration 226 / scripts/bootstrap-first-admin):
# the email whose profiles row gets is_admin=true on bootstrap.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- .env vs .env.local split (Spec 113 §3) ---------------------------------
# Next.js loads BOTH files; .env.local WINS on any key present in both and is
# gitignored. Convention in this repo:
#   .env        → cloud/default values (cloud Supabase NEXT_PUBLIC_SUPABASE_*,
#                 shared non-secret defaults)
#   .env.local  → your machine's local-stack overrides (e.g. `supabase start`
#                 NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 + its anon
#                 key), plus personal secrets.
# TRAP (hit live 2026-07-19): if NEXT_PUBLIC_SUPABASE_* still points at the
# CLOUD project while DATABASE_URL/PG_* point at the LOCAL stack, the app
# authenticates against cloud users but reads/writes the local DB (mixed
# planes). `node scripts/ai-env-check.mjs` warns on exactly this mismatch.
