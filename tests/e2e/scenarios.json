    {
      "id": "L-RANDOM",
      "count": 1000,
      "how": "lookup ?q=<address_full>; assert it lands on the same parcel_id, then check the bounds and the shown fields",
      "expect": {
        "resolution": "unique",
        "lands_on_same_parcel": true,
        "schema_parses": true,
        "no_empty_shown_field": true
      },
      "owner": "MF-44",
      "status": "active",
      "sql": "SELECT parcel_id, address_full, zone_d, coverage_frac FROM (SELECT DISTINCT ON (p.parcel_id) p.parcel_id, ap.address_full, (regexp_match(p.zoning_zn_string, '[(; ]d([0-9.]+)'))[1]::numeric AS zone_d, p.bylaw_max_coverage_pct / 100.0 AS coverage_frac FROM parcels p JOIN parcel_address_points pap ON pap.parcel_id = p.id JOIN address_points ap ON ap.address_point_id = pap.address_point_id AND ap.retired_at IS NULL WHERE p.zoning_class IS NOT NULL ORDER BY p.parcel_id, ap.address_full) s ORDER BY md5(parcel_id || $1) LIMIT $2",
      "sql_params": "$1 the night seed (logged), $2 count; read-only on the test stack",
      "runner": "tests/e2e/lot-sweep.spec.ts"
