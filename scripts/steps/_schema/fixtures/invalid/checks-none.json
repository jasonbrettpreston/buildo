    {
      "key": "errors",
      "type": "array",
      "consumers": [
        "run-chain.js"
      ]
    }
  ],
  "deviations": [
    {
      "from": "Spec 122 §8.2's pilot table, which assigns assert_schema write class L (verdict_only)",
      "why": {
        "text": "The standalone pipeline_runs INSERT and UPDATE are the RUNNER's ledger row, not a step output; claim #39 consolidates ledger ownership into the library, so post-conversion this step writes nothing and outputs is \"none\" as the ASSERT profile requires.",
        "liveness": {
          "kind": "file",
          "ref": "scripts/run-chain.js"
        }
      },
      "adjudicated_by": "Spec 122 §1.10 required-field profile",
      "date": "2026-08-24"
    },
    {
      "from": "the live emission records_total: 0 at assert-schema.js:557",
      "why": {
        "text": "§1.10 forces an ASSERT to declare counters \"none\". Spec 122 §12.5 records that 0 of 5 ASSERTs comply today, so this profile is NORMATIVE, not descriptive; the differential at conversion must show the counter emission moving to the runner rather than changing value silently.",
        "liveness": {
          "kind": "spec",
          "ref": "docs/specs/01-pipeline/122_pipeline_step_optimization.md"
        }
      },
      "adjudicated_by": "operator ruling R2 / §1.10",
      "date": "2026-08-24"
    }
  ],
  "limitations": [
    {
      "what": "A non-OK HTTP response inside validateTypeSample returns true, so the permit cost-type check cannot distinguish 'verified' from 'never ran'.",
      "measured": "assert-schema.js:162 — `if (!res.ok) return true; // non-fatal`",
      "check_id": "permit_cost_type_sample"
    },
    {
      "what": "Shapefile and ZIP sources are checked for reachability only; their attribute contracts are enforced post-download inside each loader, so a reachable-but-drifted archive passes this step.",
      "measured": "assert-schema.js:351-397 — five checkUrlAccessible calls, no attribute inspection",
      "check_id": "source_archives_reachable"
    }
  ],
  "interpretation": "none",
  "recovery": "none",
  "database": {
    "class": "primary",
    "min_migration": 241,
    "assert_current_database": "postgres"
  },
  "counters": "none",
  "config": "none",
  "sharing": {
    "chains": "derived",
    "shared": "derived",
    "slug_forms": "derived",
    "varies_by_chain": {
      "checks": "per_chain",
      "phase": {
        "permits": 1,
        "coa": 1,
        "sources": 1
      },
      "audit_table": "per_chain",
      "scope": "per_chain"
    },
    "on_contention": "self_skip"
  },
  "terminals": [
    {
      "id": "lock_held_elsewhere",
      "kind": "skip_lock_contention",
      "status": "self_skipped",
      "records_meta": {
        "skipped": "bool",
        "reason": "string"
      },
      "why": {
        "text": "pipeline.js emits PIPELINE_SUMMARY with records_meta {skipped:true, reason:'advisory_lock_held_elsewhere'} because assert-schema passes no opts to withAdvisoryLock. Contention IS observable today; what was missing is a declared policy.",
        "liveness": {
          "kind": "file",
          "ref": "scripts/lib/pipeline.js"
        }
      }
    },
    {
      "id": "all_checks_passed",
      "kind": "success",
      "status": "completed",
      "records_meta": {
        "checks_passed": "string",
        "checks_failed": "int",
        "audit_table": "object"
      }
    },
    {
      "id": "schema_drift_detected",
      "kind": "fail_check",
      "status": "failed",
      "records_meta": {
        "checks_failed": "int",
        "errors": "array",
        "audit_table": "object"
      },
      "why": {
        "text": "Schema drift must halt the chain — the step throws after emitting, so the audit table is recorded before the failure propagates.",
        "liveness": {
          "kind": "check",
          "ref": "permit_columns"
        }
      }
    },
    {
      "id": "fetch_error",
      "kind": "fail_error",
      "status": "failed",
      "records_meta": {
        "checks_failed": "int",
        "errors": "array",
        "audit_table": "object"
      },
      "why": {
        "text": "A CKAN metadata fetch or CSV range request that throws is caught per-source, reddens the audit row and then fails the step; it is a distinct exit path from a clean drift detection.",
        "liveness": {
          "kind": "external",
          "ref": "ckan0.cf.opendata.inter.prod-toronto.ca"
        }
      }
    }
  ]
}
