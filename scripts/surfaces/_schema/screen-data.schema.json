{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://buildo.local/schemas/screen-data.schema.json",
  "$comment": "MF-42 (FE-31; plan.min cut 7: what JSON Schema can refuse, the schema refuses, with no hand code). The shapes of the converted manifest, a screen golden, a content file, bindings.json and the vendored manifest. Read by scripts/surfaces/screen-checks.mjs; its AJV messages are printed as SV-<ARM> <file>: <path> <message>.",
  "definitions": {
    "mf": { "type": "string", "pattern": "^MF-\\d+$" },
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "strings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "converted", "pending_conversion", "parked", "report", "queue"],
      "properties": {
        "$comment": { "type": "string" },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["programme_scopes", "expected_count"],
          "properties": {
            "programme_scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
            "expected_count": { "type": "integer", "minimum": 0 }
          }
        },
        "converted": { "$ref": "#/definitions/ids" },
        "pending_conversion": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "row"],
            "properties": { "id": { "type": "string", "minLength": 1 }, "row": { "$ref": "#/definitions/mf" } }
          }
        },
        "parked": { "$ref": "#/definitions/ids" },
        "report": { "$ref": "#/definitions/ids" },
        "waits": { "$ref": "#/definitions/mf" },
        "queue": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "converted": { "type": "array", "maxItems": 0 } } },
      "then": { "required": ["waits"] },
      "else": { "not": { "required": ["waits"] } }
    },
    "content": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "props": { "type": "object" },
        "children": { "type": "array" }
      }
    },
    "golden": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "state", "target", "covers", "props", "fingerprint"],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "target": { "enum": ["web", "mobile", "pdf"] },
        "covers": { "$ref": "#/definitions/ids" },
        "situation": { "type": "string", "minLength": 1 },
        "props": { "$ref": "#/definitions/node" },
        "fingerprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files"],
          "properties": { "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{16}$" } } }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["libraries", "vendor_dir", "vendor_manifest", "framework", "mount_internal", "module_roots", "modules", "mounts", "providers",
        "promoted_entries", "test_globs", "widget_types", "ref_kinds", "non_display_keys"],
      "properties": {
        "$comment": { "type": "string" },
        "libraries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["web", "mobile"],
          "properties": { "web": { "$ref": "#/definitions/ids" }, "mobile": { "$ref": "#/definitions/ids" } }
        },
        "vendor_dir": { "type": "string", "minLength": 1 },
        "vendor_manifest": { "type": "string", "minLength": 1 },
        "framework": { "$ref": "#/definitions/ids" },
        "mount_internal": { "$ref": "#/definitions/ids" },
        "module_roots": { "$ref": "#/definitions/ids" },
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "platform", "archetypes", "owner", "exports"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "platform": { "enum": ["web", "mobile"] },
              "archetypes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "owner": { "type": "string", "minLength": 1 },
              "exports": { "$ref": "#/definitions/strings" }
            }
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["surface", "path"],
            "properties": { "surface": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 } }
          }
        },
        "providers": { "$ref": "#/definitions/ids" },
        "promoted_entries": { "$ref": "#/definitions/ids" },
        "test_globs": { "$ref": "#/definitions/ids" },
        "widget_types": { "type": "object", "additionalProperties": { "$ref": "#/definitions/strings" } },
        "ref_kinds": { "$ref": "#/definitions/ids" },
        "non_display_keys": { "$ref": "#/definitions/ids" }
      }
    },
    "vendor_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cli", "registry", "files"],
      "properties": {
        "$comment": { "type": "string" },
        "cli": { "const": "@react-native-reusables/cli@0.7.1" },
        "registry": { "const": "nativewind" },
        "shadcn_version": { "type": "string", "minLength": 1 },
        "waits": { "$ref": "#/definitions/mf" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "source"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "source": { "enum": ["cli", "docs"] },
              "registry_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      },
      "if": { "properties": { "files": { "type": "array", "maxItems": 0 } } },
      "then": { "required": ["waits"] }
    }
  }
}
