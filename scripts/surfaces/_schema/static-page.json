 "screens": {
  "mobile_parcel_semi_question": {
   "prefix": "parcel-semi",
   "contract": "contract_parcels_lookup",
   "binding": "mobile/src/components/surfaces/SemiQuestionBinding.tsx",
   "platforms": [
    "mobile"
   ],
   "sections": [
    {
     "kind": "bar",
     "id": "header",
     "parts": [
      {
       "role": "back",
       "icon": "ChevronLeft",
       "content": "back.label",
       "action": "back"
      }
     ]
    },
    {
     "kind": "status",
     "id": "loading",
     "when": "loading",
     "content": "state.loading"
    },
    {
     "kind": "notice",
     "id": "ratelimit",
     "when": "rate_limited",
     "tone": "error",
     "icon": "AlertTriangle",
     "parts": [
      {
       "role": "text",
       "content": "state.ratelimit",
       "vars": {
        "seconds": "errors.429.retryAfterSeconds"
       }
      }
     ]
    },
    {
     "kind": "notice",
     "id": "entitlement",
     "when": "entitlement",
     "tone": "neutral",
     "icon": "Info",
     "parts": [
      {
       "role": "text",
       "content": "state.entitlement"
      }
     ]
    },
    {
     "kind": "notice",
     "id": "error",
     "when": "unexpected",
     "tone": "error",
     "icon": "AlertTriangle",
     "parts": [
      {
       "role": "text",
       "content": "state.error",
       "when": "plain_error"
      },
      {
       "role": "text",
       "content": "state.schema_drift",
       "when": "schema_drift"
      },
      {
       "role": "button",
       "id": "retry",
       "variant": "outline",
       "label": "retry.label",
       "content": "retry.text",
       "action": "retry",
       "when": "plain_error"
      }
     ]
    },
    {
     "kind": "text",
     "id": "question",
     "when": "ask",
     "role": "header",
     "content": "question.title"
    },
    {
     "kind": "choices",
     "id": "answer",
     "when": "ask",
     "list": "answers",
     "select": "selected",
     "content": "answer",
     "action": "select",
     "arg": "parcelId"
    },
    {
     "kind": "button",
     "id": "continue",
     "when": "ask",
     "variant": "default",
     "label": "select.label",
     "content": "select.go",
     "idle": "select.none",
     "action": "push",
     "target": "route",
     "busy": "busy"
    }
   ]
  },
  "mobile_parcel_wall": {
   "prefix": "parcel-wall",
   "contract": "contract_parcels_entitlement",
   "binding": "mobile/src/components/surfaces/WallBinding.tsx",
   "platforms": [
    "mobile"
   ],
   "sections": [
    {
     "kind": "notice",
     "id": "limit",
     "when": "limit",
     "tone": "neutral",
     "icon": "Info",
     "parts": [
      {
       "role": "title",
       "content": "wall.limit.title",
       "vars": {
        "limit": "reportsLimit"
       }
      },
      {
       "role": "small",
       "content": "wall.limit.reset",
       "vars": {
        "date": "resetsOnDisplay"
       }
      },
      {
       "role": "text",
       "content": "wall.limit.opened"
      },
      {
       "role": "text",
       "content": "wall.limit.stay"
      },
      {
       "role": "text",
       "content": "wall.plan"
      }
     ]
    },
    {
     "kind": "notice",
     "id": "reactivate",
     "when": "reactivate",
     "tone": "neutral",
     "icon": "Info",
     "parts": [
      {
       "role": "text",
       "content": "wall.reactivate"
      },
      {
       "role": "text",
       "content": "wall.plan"
      }
     ]
    },
    {
     "kind": "notice",
     "id": "error",
     "when": "error",
     "tone": "error",
     "icon": "AlertTriangle",
     "parts": [
      {
       "role": "text",
       "content": "wall.error"
      }
     ]
    },
    {
     "kind": "button",
     "id": "tracked",
     "variant": "default",
     "label": "wall.tracked",
     "content": "wall.tracked",
     "action": "push",
     "target": "route"
    }
   ]
  }
 }
