  "rows": {
    "900.2.10(931)": {
      "explanation": "Exception R 931 (Davisville / Manor Rd. / Hillsdale Ave. area) sets a 9.0 m minimum lot frontage for detached houses, bans vehicle entrances through the front wall of a house, limits raised rear decks and balconies (4.0 m2 maximum area, 1.8 m side yard setback, no encroachment into the rear yard), requires additions above the first storey of an existing detached house to meet the setbacks, carries a retirement-home permission for 84 Davisville Ave., and keeps several former City of Toronto by-laws and sections in force, some only on named addresses.",
      "code_refs": "none"
    }
  }
