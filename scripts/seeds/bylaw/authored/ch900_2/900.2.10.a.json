 "rows": {
  "900.2.10(296)": {"explanation": "Exception R 296 has no site specific provisions. Prevailing by-laws apply on a list of named addresses (Callender St., Harvard Ave., Lukow Ter., MacDonell Ave., Wabash Ave., Wright Ave., Pearson Ave., Sorauren Ave., Triller Ave.); these are never evaluated.", "code_refs": "none"},
  "900.2.10(322)": {"explanation": "Exception R 322 has no site specific provisions. Former City of Toronto by-laws prevail on named addresses on Coxwell Ave., Donlands Ave., Eaton Ave. and Strathmore Blvd.; these are never evaluated.", "code_refs": "none"},
  "900.2.10(4)": {"explanation": "Exception R 4 requires the lands to comply with exception 900.2.10(7). A former section and former by-law prevail at 310 to 320 Gerrard Street East and are never evaluated.", "code_refs": "none"},
  "900.2.10(5)": {"explanation": "Exception R 5 allows a dwelling unit only in a detached house, semi-detached house or duplex. A duplex needs a 3.0 m minimum side yard setback, and a raised platform may not encroach into the required front or rear yard setback. No prevailing by-laws apply.", "code_refs": "none"},
  "900.2.10(604)": {"explanation": "Exception R 604 makes an apartment building a non-permitted building type on these lands. No prevailing by-laws apply.", "code_refs": "none"},
  "900.2.10(7)": {"explanation": "Exception R 7 permits a nursing home, retirement home and religious residence under site conditions (building originally a house or townhouse, or a lot on or near a major street), and relieves a community centre or library from the City operation requirement. Prevailing by-laws apply at Wellesley Street East and Christie Street.", "code_refs": "none"},
  "900.2.10(730)": {"explanation": "Exception R 730 permits office and retail store uses at 1615 Dufferin St. Prevailing by-laws apply on named addresses on Auburn Ave., Hendrick Ave., Peterborough Ave. and Rushton Rd. and are never evaluated.", "code_refs": "none"},
  "900.2.10(735)": {"explanation": "Exception R 735 sets a bespoke development for 455 Dovercourt Road (mixed use, dwelling units plus non-residential floor area, ancillary stacked parking garage) tied to By-law 687-2014 diagrams. Many prevailing by-laws apply across named addresses and are never evaluated.", "code_refs": "none"},
  "900.2.10(736)": {"explanation": "Exception R 736 adds rules for garden suites at 91-209 Parkmount Road (odd) and 160 Mountjoy Avenue, including a 2.5 m minimum rear yard setback. Prevailing by-laws apply on many named addresses and are never evaluated.", "code_refs": "none"},
  "900.2.10(737)": {"explanation": "Exception R 737 permits two dwelling units at 64 Glenlake Ave. and medical office and office uses at 209 Mavety Street. Prevailing by-laws apply on many named addresses and are never evaluated.", "code_refs": "none"},
  "900.2.10(740)": {"explanation": "Exception R 740 has no site specific provisions. Prevailing by-laws apply at Dupont St., Lansdowne Ave., St. Clarens Ave., Margueretta St., Pauline Ave. and Dufferin Street and are never evaluated.", "code_refs": "none"},
  "900.2.10(741)": {"explanation": "Exception R 741 has no site specific provisions. Former City of Toronto by-laws prevail on named addresses on Coxwell Ave. and Darrell Ave. and are never evaluated.", "code_refs": "none"},
  "900.2.10(742)": {"explanation": "Exception R 742 has no site specific provisions. Former City of Toronto by-laws prevail at Ascot Ave., Boon Ave. and Dufferin St. and are never evaluated.", "code_refs": "none"},
  "900.2.10(750)": {"explanation": "Exception R 750 has no site specific provisions. Prevailing by-laws apply on named addresses on Duvernet Ave., Eastwood Rd., Edgewood Ave., Heyworth Cres., Kingston Rd. and Newbold Ave. and are never evaluated.", "code_refs": "none"},
  "900.2.10(804)": {"explanation": "Exception R 804 requires the lands to comply with exception 900.2.10(7). Prevailing by-laws apply at 142 Argyle St. and on Dovercourt Road and are never evaluated.", "code_refs": "none"},
  "900.2.10(806)": {"explanation": "Exception R 806 requires the lands to comply with exception 900.2.10(7). Prevailing by-laws apply at Bathurst St., Dundas St. W., Markham St. and Wolseley St. and are never evaluated.", "code_refs": "none"},
  "900.2.10(930)": {"explanation": "Exception R 930 sets a 7.5 m minimum lot frontage for a lot with a detached house, requires additions above the first storey of a lawfully existing detached house to meet the minimum building setbacks, bans a vehicle entrance through the front main wall, and limits raised rear platforms (4.0 m2, 1.8 m side setback, no rear yard encroachment). Prevailing sections and by-laws apply on named addresses.", "code_refs": "none"}
 }}
