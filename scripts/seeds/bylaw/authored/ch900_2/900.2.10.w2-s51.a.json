"rows": {
"900.2.10(731)": {"explanation":"Exception R 731 permits a vehicle fuel station at 861 Avenue Rd. and lists former City of Toronto by-law 438-86 sections 12(2) 118, 12(2) 119 and (for 866 Avenue Rd.) 12(1) 443 as prevailing; these alternate paths are not evaluated.","code_refs":"none"},
"900.2.10(407)": {"explanation":"Exception R 407 requires the lands to comply with exception 900.2.10(7) and lists section 12(1) 309 of former City of Toronto By-law 438-86 as prevailing for 123 Coxwell Ave.; the prevailing path is not evaluated.","code_refs":"none"},
"900.2.10(766)": {"explanation":"Exception R 766 has no site specific provisions; former City of Toronto by-law 808-78 prevails at 436 Perth Ave. and is not evaluated.","code_refs":"none"},
"900.2.10(285)": {"explanation":"Exception R 285 has no site specific provisions; section 12 (1) 271 of former City of Toronto By-law 438-86 prevails and is not evaluated.","code_refs":"none"},
"900.2.10(850)": {"explanation":"Exception R 850 requires the lands to comply with exception 900.2.10(4) and lists a former City of Toronto By-law 438-86 section and several former by-laws as prevailing, some on named lots; those prevailing paths are not evaluated.","code_refs":"none"}
