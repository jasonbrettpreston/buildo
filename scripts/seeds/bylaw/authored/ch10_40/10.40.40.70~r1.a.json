    },
    "10.40.40.70(2)": {
      "explanation": "The minimum rear yard setback in the RS zone is the greater of 7.5 metres and 25% of the lot depth.",
      "code_refs": "none"
    },
    "10.40.40.70(3)": {
      "explanation": "The minimum side yard setback in the RS zone depends on the required minimum lot frontage: 0.6 m under 6.0 m, 0.9 m from 6.0 m to under 12.0 m, 1.2 m from 12.0 m to under 15.0 m, and 1.5 m at 15.0 m or more; a non-residential building needs 1.8 m.",
      "code_refs": "none"
    },
    "10.40.40.70(4)": {
      "explanation": "A townhouse or apartment building on a lot abutting a major street has its own minimum setbacks that replace those in (1) to (3): front 3.0 m to 6.0 m depending on lot depth and context, rear 7.5 m, and side setbacks that vary by building type, window and wall layout, and corner-lot position.",
