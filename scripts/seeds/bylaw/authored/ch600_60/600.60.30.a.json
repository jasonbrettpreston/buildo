  "rows": {
    "600.60.30(1)": {
      "explanation": "An apartment building (seven or more dwelling units) gets no special treatment from the sixplex rules: in the R Zone and RM Zone it follows the ordinary regulations listed, and every other regulation in the By-law.",
      "code_refs": "none"
    },
    "600.60.30(2)": {
      "explanation": "An existing, lawful apartment building with five or six dwelling units is not treated as a fiveplex or sixplex and the Section 600.60 sixplex rules do not apply to it. It must meet all other By-law regulations or get a Section 45 minor variance.",
      "code_refs": "none"
    },
    "600.60.30(3)": {
      "explanation": "A detached houseplex with five or six dwelling units follows the Article 600.60.40 rules, and otherwise must meet all other regulations in the By-law or get a Section 45 minor variance (except for the conversion cases excluded in 600.60.40(3)(D)).",
