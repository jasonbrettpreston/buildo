  "rows": {
    "600.60.40(1)": {
      "explanation": "Where the zone label has a unit count (the letter u) below 6, up to 6 dwelling units are allowed on the lot. A detached houseplex with five or six dwelling units is a permitted building type in the Residential Zone category if it meets the zone regulations and other requirements, or has a Section 45 minor variance.",
      "code_refs": "none"
    },
    "600.60.40(2)": {
      "explanation": "A detached houseplex with five or six dwelling units may be up to 10.5 m high if its lowest level has joist bottoms 1.0 to 1.5 m above grade over at least 80 percent of the floor area, at least 2.4 m floor to ceiling over at least 80 percent of that floor area, and wholly or partly contains a dwelling unit.",
      "code_refs": "none"
    },
    "600.60.40(3)": {
      "explanation": "In the Residential Zone category an existing detached house may be converted to a five or six unit detached houseplex, and stay lawfully existing, if the new units are entirely inside the building as it lawfully existed. Additions must meet all other regulations or get a minor variance. No part of a semi-detached houseplex, semi-detached house or townhouse may be converted to a fiveplex or sixplex. The source text for the definition of lawfully existing in (C) is incomplete.",
      "code_refs": "none"
    }
  }
