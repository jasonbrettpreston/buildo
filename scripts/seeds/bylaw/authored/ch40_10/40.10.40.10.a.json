    "40.10.40.10(1)": {"explanation": "In a CR lot under Development Standard Set 1, the maximum height is the HT value on the Height Overlay Map, or 16.0 m where the map has none. Neither applies in the area bounded by York, Adelaide West, Wellington West and Yonge streets.", "code_refs": "none"},
    "40.10.40.10(2)": {"explanation": "In a CR lot under Development Standard Set 2, the maximum height is the HT value on the Height Overlay Map, or 14.0 m where the map has none.", "code_refs": "none"},
    "40.10.40.10(3)": {"explanation": "In a CR lot under Development Standard Set 3, the maximum height is the HT value on the Height Overlay Map, or 11.0 m where the map has none.", "code_refs": "none"},
    "40.10.40.10(4)": {"explanation": "In certain CR lots with a residential component in Policy Areas 1 to 4, a building must be at least 10.5 m high and have at least 3 storeys. Vehicle fuel stations are exempt.", "code_refs": "none"},
    "40.10.40.10(5)": {"explanation": "In the CR zone the first storey must be at least 4.5 m high, measured from the average ground along the front lot line to the second-storey floor. Loading, bicycle parking, shower areas and building-operation spaces are excluded, and qualifying dwelling units may have two levels within that height.", "code_refs": "none"},
    "40.10.40.10(6)": {"explanation": "A place of worship in the CR zone does not have to meet the first-storey height rule.", "code_refs": "none"},
    "40.10.40.10(7)": {"explanation": "The maximum number of storeys in a CR building is the ST value on the Height Overlay Map; where the map has no ST value, storeys are not limited by this regulation.", "code_refs": "none"},
    "40.10.40.10(8)": {"explanation": "In a CR lot under Development Standard Set 4, the maximum height is the HT value on the Height Overlay Map, or 20.0 m where the map has none.", "code_refs": "none"},
    "40.10.40.10(9)": {"explanation": "In a CR lot under Development Standard Set 5, the maximum height is the HT value on the Height Overlay Map, or 27.0 m where the map has none.", "code_refs": "none"}
