  "rows": {
    "900.5.10(103)": {"explanation": "Exception RT 103 limits the lands to one dwelling unit per lot, sets side setbacks of 1.2 metres (4.5 metres on a street side), caps lot coverage at 50 percent, requires 7.5 metres from named roads and the railway, requires the parking space inside the residential building, and sets an attached garage 0.3 metres from a side lot line. No prevailing by-laws apply.", "code_refs": "none"},
    "900.5.10(297)": {"explanation": "Exception RT 297 sets a 3.0 metre front setback, reduced side setbacks (0.9 and 0.3 metres, or 0.9 metres on one side if attached), bars encroachments into the required side yard, limits height to the lesser of 3 storeys and 10.5 metres, caps lot coverage at 50 percent, sets garage entrances facing the street back 6.0 metres, and requires the parking space inside the residential building. No prevailing by-laws apply.", "code_refs": "none"},
    "900.5.10(234)": {"explanation": "Exception RT 234 adds no site specific provisions; Section 64.16(17) of the former City of North York zoning by-law 7625 prevails and is not evaluated here.", "code_refs": "none"},
