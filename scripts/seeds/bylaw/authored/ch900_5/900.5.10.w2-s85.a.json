  "rows": {
    "900.5.10(112)": {
      "explanation": "Exception RT 112 sets site-specific rules: one dwelling unit per lot, minimum lot frontage and area as they existed on the by-law enactment date, side setbacks of 1.2 m (4.5 m on a street side), 7.5 m from named roads, 50% maximum lot coverage, and parking inside the residential building. Former Scarborough by-law 14402 also prevails.",
      "code_refs": "none"
