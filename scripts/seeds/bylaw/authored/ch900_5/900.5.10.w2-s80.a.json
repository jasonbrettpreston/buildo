  "rows": {
    "900.5.10(145)": {"explanation": "Exception RT 145 allows one dwelling unit per lot, keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums, requires the parking space to be in a building, caps height at the lesser of 3 storeys or 9.5 metres and caps lot coverage at 50 percent. No prevailing by-laws apply.", "code_refs": "none"},
    "900.5.10(163)": {"explanation": "Exception RT 163 adds no site specific provisions; Section 64.16(7) and the Schedule 'D' Airport Hazard Map of the former City of North York zoning by-law 7625 prevail and are not evaluated here.", "code_refs": "none"},
    "900.5.10(125)": {"explanation": "Exception RT 125 allows one dwelling unit per lot, keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums, sets side setbacks of 1.5 metres (4.5 metres next to a street), caps lot coverage at 50 percent and requires the parking space to be in the residential building. No prevailing by-laws apply.", "code_refs": "none"}
