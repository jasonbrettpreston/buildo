 "rows": {
  "220.5.10.1(1)": {"explanation": "Loading spaces have to be provided following the rules in 220.5.10.1(2) to (9).", "code_refs": "none"},
  "220.5.10.1(10)": {"explanation": "A building with fewer than 30 dwelling units on a lot under 1,000 m2 does not need a Type G loading space.", "code_refs": "none"},
  "220.5.10.1(11)": {"explanation": "An apartment building with 400 or more dwelling units can meet its Type C loading space requirement by providing a Type A space, a Type B space, or a second Type G space instead.", "code_refs": "none"},
  "220.5.10.1(2)": {"explanation": "A building with dwelling units needs no loading space at 0 to 30 units, 1 Type G space at 31 to 399 units, and 1 Type G plus 1 Type C space at 400 units or more.", "code_refs": "none"},
  "220.5.10.1(3)": {"explanation": "A building with a retail store, eating establishment or personal service shop needs loading spaces by gross floor area: none under 500 m2; 1 Type B from 500 m2; 2 Type B from 2,000 m2; 3 Type B from 5,000 m2; 1 Type A and 3 Type B from 10,000 m2; and one more Type C from 20,000 m2, which stays the same from 30,000 m2.", "code_refs": "none"}
 }}
