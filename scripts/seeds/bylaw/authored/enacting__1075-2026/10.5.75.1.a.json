  "10.5.75.1(4)(A)(ii)(b)@1075-2026": {"explanation": "A device may rise 2.0 m above the permitted maximum height on an apartment or non-residential building, and 1.2 m above it on other residential buildings.", "code_refs": "none"},
  "10.5.75.1(4)(B)@1075-2026": {"explanation": "A ground mounted device may sit in a rear or side yard that does not abut a street, no closer than 1.0 m to a rear or side lot line, no higher than 2.5 m and no larger than 40.0 m2. It counts toward lot coverage.", "code_refs": "none"},
  "10.5.75.1(6)@1075-2026": {"explanation": "In the Residential Zone category, a heating, ventilation and air conditioning device may project up to 0.9 m into a required building setback if it stays at least 0.3 m from the lot line.", "code_refs": "none"},
  "10.5.75.1(7)@1075-2026": {"explanation": "In the Residential Zone category, an energy storage system ancillary to a building may be in the front, rear or side yard and may project up to 0.6 m into a required setback if it stays at least 0.3 m from the lot line.", "code_refs": "none"}}}
