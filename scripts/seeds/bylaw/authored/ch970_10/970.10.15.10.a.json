  "970.10.15.10(1)": {"explanation": "In residential zones, a house-type building's gross floor area can be reduced by the basement, by a limited void area, by required parking, and (for a detached house on a lot wider than 12.0 m) by one extra parking space.", "code_refs": "none"},
  "970.10.15.10(2)": {"explanation": "A garage serving the required parking of homes on neighbouring lots may sit on the shared side lot line.", "code_refs": "none"},
