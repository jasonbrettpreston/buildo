  "970.10.15.10(4)": {"explanation": "A secondary suite's required parking space may be in the front yard if it is on a driveway.", "code_refs": "none"},
  "970.10.15.10(5)": {"explanation": "In the R zone ancillary buildings may cover at most 5 percent of the lot, except pool water surfaces that comply with 10.5.60.70(2) and ancillary buildings holding required parking.", "code_refs": "none"},
