  "rows": {
    "970.10.15.5(1)": {"explanation": "A lot in Policy Area 3 or 4 uses the policy area parking rates for the whole lot if buildings cover at least 50 percent of the area within 40 metres of the street lot line; otherwise the rates for uses outside the policy areas apply.", "code_refs": "none"},
    "970.10.15.5(10)": {"explanation": "In Policy Area 1, required vehicle parking can be cut by 1 space for each 5 bicycle spaces provided above the Chapter 230 minimum, up to a 20 percent reduction.", "code_refs": "none"},
    "970.10.15.5(11)": {"explanation": "When 5 or more parking spaces are required, some must be accessible: 1 if fewer than 13 are required, 1 per 25 (or part) for 13 to 100, and 5 plus 1 per 50 (or part) above 100.", "code_refs": "none"},
    "970.10.15.5(12)": {"explanation": "A medical office or clinic established between May 26, 2017 and July 22, 2022 must make at least 10 percent of its required parking accessible and keep any lawfully existing accessible spaces.", "code_refs": "none"},
    "970.10.15.5(13)": {"explanation": "Where Table 200.5.10.1 gives a minimum and a maximum, the parking provided may not be below the minimum or above the maximum; where there is no minimum, no spaces are required.", "code_refs": "none"},
    "970.10.15.5(14)": {"explanation": "Effective parking spaces are used only to work out how many accessible spaces are required. They do not replace the ordinary parking rates or the number of spaces actually provided.", "code_refs": "none"},
    "970.10.15.5(15)": {"explanation": "For accessible parking, the effective parking spaces are the greater of the permitted spaces provided and the number calculated from Table 970.10.15.5(1).", "code_refs": "none"},
    "970.10.15.5(16)": {"explanation": "Table 970.10.15.5(1) sets the effective parking space rates by use: for example 1.0 per unit in multiple dwelling unit buildings, 0.1 per unit for visitors, nothing for houses up to fourplexes and secondary suites, and area-based rates for non-residential uses.", "code_refs": "none"}
  }
