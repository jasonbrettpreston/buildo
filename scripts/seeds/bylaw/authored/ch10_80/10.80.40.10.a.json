  "rows": {
    "10.80.40.10(1)": {
      "explanation": "Maximum building height in the RM zone is the HT number on the Height Overlay Map, or where none is mapped 10.0 m for detached and semi-detached houses and 12.0 m for other buildings; houseplexes get at least 10.0 m, and on major streets townhouses get at least 13.0 m and apartment buildings at least 19.0 m.",
      "code_refs": "none"
    },
    "10.80.40.10(2)": {
      "explanation": "For detached and semi-detached houses, main walls (side walls, or front and rear walls for a share of their width that depends on frontage) may be no taller than the higher of 7.0 m or 2.5 m below the maximum height; this does not apply to townhouses or apartments on major streets.",
      "code_refs": "none"
    },
    "10.80.40.10(3)": {
      "explanation": "The maximum number of storeys is the ST number on the Height Overlay Map (unlimited where none is mapped, and not applied to houseplexes); on major streets townhouses may have at least four storeys and apartment buildings at least six.",
      "code_refs": "none"
    },
    "10.80.40.10(4)": {
      "explanation": "The main front or side entrance of a detached or semi-detached house in the RM zone may be at most 1.2 m above the ground.",
      "code_refs": "none"
    },
    "10.80.40.10(5)": {
      "explanation": "On detached and semi-detached houses of two or more storeys, dormers do not count as main walls if they sit above walls within the wall-height limit and take up no more than 40 percent of that wall width.",
      "code_refs": "none"
    },
    "10.80.40.10(6)": {
      "explanation": "A flat-roofed detached or semi-detached house may add main walls above the wall-height limit if the extra front and rear walls are set back at least 1.4 m.",
      "code_refs": "none"
    }
