  "rows": {
    "10.80.20.40(1)": {
      "explanation": "In the RM zone, homes are allowed in detached and semi-detached houses and houseplexes; apartment buildings where the zone label has no u value or one of 5 or more (or on a major street); and townhouses where the u value is absent or 3 or more, and only on a major street.",
      "code_refs": "none"
    },
    "10.80.20.40(2)": {
      "explanation": "Even if a site-specific (Chapter 900) exception would otherwise limit the building types, a houseplex, townhouse or apartment building is allowed in the RM zone if it meets the RM zone rules and the rest of the By-law, or gets a minor variance.",
      "code_refs": "none"
    }
