 "rows": {
  "10.20.40.10(1)": {
   "explanation": "In the RD zone the maximum height is the HT number on the Height Overlay Map, or 10.0 m where none is shown. A detached houseplex gets the greater of HT or 10.0 m; on a major street, townhouses get at least 13.0 m and apartment buildings at least 19.0 m.",
   "code_refs": "none"
  },
  "10.20.40.10(2)": {
   "explanation": "Main walls on the sides, or on the front and rear, may be no taller than the higher of 7.0 m or 2.5 m below the maximum height. This does not apply to townhouses or apartment buildings on a major street.",
   "code_refs": "none"
  },
  "10.20.40.10(3)": {
   "explanation": "The maximum number of storeys is the ST number on the Height Overlay Map; with no ST number there is no storey limit. Detached houseplexes are exempt, and on a major street townhouses get at least four storeys and apartment buildings at least six.",
   "code_refs": "none"
  },
  "10.20.40.10(4)": {
   "explanation": "For a flat or shallow roof, main walls may be no taller than the higher of 7.2 m or 2.5 m below the maximum height, with extra walls above allowed if stepped back 1.4 m. Not for townhouses or apartment buildings on a major street.",
   "code_refs": "none"
  },
  "10.20.40.10(5)": {
   "explanation": "A parapet on a flat or shallow roof may rise up to 0.3 m above the main wall height limit.",
   "code_refs": "none"
  },
  "10.20.40.10(6)": {
   "explanation": "The main front or side entrance of a house can be no more than 1.2 m above the ground.",
   "code_refs": "none"
  },
  "10.20.40.10(7)": {
   "explanation": "Dormers above a compliant main wall do not count as main walls if their total width is no more than 40% of that wall width.",
   "code_refs": "none"
  },
  "10.20.40.10(8)": {
   "explanation": "An attic space up to 20 m2 used only for mechanical equipment does not count as a storey.",
   "code_refs": "none"
  }
 }
