 "rows": {
  "10.20.40.70(7)": {
   "explanation": "On a lot that abuts a major street, a townhouse or apartment building must meet these minimum setbacks instead of the general ones. Front yard: 3.0 m (or the lesser of the 10.5.40.70(1) front setback and 6.0 m where that rule applies) for lots up to 36.0 m deep, and 6.0 m for through lots or lots deeper than 36.0 m. Rear yard: 7.5 m. Side yard: 0.9 m or 7.5 m for townhouses depending on whether all units front a street; for apartment buildings 2.4 m, 5.5 m where the main wall has primary windows, 7.5 m for wall portions longer than 25.0 m, and 3.0 m beside a street on a corner lot.",
   "code_refs": "none"
  }
 }
