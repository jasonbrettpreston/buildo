 "rows": {"1.20.2(1)": {"explanation": "A reference to a chapter, section, article, clause or regulation means one in this by-law.", "code_refs": "none"}, "1.20.2(10)": {"explanation": "General regulations that apply to all zones or to a zone category may be replaced by more specific regulations in the zone sections.", "code_refs": "none"}, "1.20.2(11)": {"explanation": "A reference to a zone category includes every zone in that category.", "code_refs": "none"}, "1.20.2(12)": {"explanation": "A reference to a zone covers its zone name, zone symbol or zone label.", "code_refs": "none"}, "1.20.2(13)": {"explanation": "A use is permitted in a zone if it is on that zone's list of permitted uses or its list of permitted uses with conditions.", "code_refs": "none"}, "1.20.2(14)": {"explanation": "If a use is not listed as permitted, it is not allowed.", "code_refs": "none"}, "1.20.2(15)": {"explanation": "A listed or defined permitted use cannot be read as including any other use.", "code_refs": "none"}, "1.20.2(2)": {"explanation": "A sub-section of a regulation may be referred to briefly, for example 20.10.30.15 as Clause 20.10.30.15 or 20.10.30.15(1) as regulation 20.10.30.15(1).", "code_refs": "none"}, "1.20.2(3)": {"explanation": "A regulation in this by-law may be referred to by its number.", "code_refs": "none"}, "1.20.2(4)": {"explanation": "Square brackets after a regulation show where it came from (city codes, by-laws, by-law sections) or the tribunal decision that approved it.", "code_refs": "none"}, "1.20.2(5)": {"explanation": "A reference to the Planning Act means the Planning Act (Ontario) as amended.", "code_refs": "none"}, "1.20.2(6)": {"explanation": "Unless the contrary appears, singular words include the plural and the reverse, 'used' includes 'intended to be used', and grammatical variations of a defined word have the same meaning.", "code_refs": "none"}, "1.20.2(7)": {"explanation": "'And' means all connected items apply; 'or' means they may apply singly, alternatively or in combination.", "code_refs": "none"}, "1.20.2(8)": {"explanation": "Where 'such as' is followed by examples, it is not limited to those examples.", "code_refs": "none"}, "1.20.2(9)": {"explanation": "Chapters 10 to 100 are zone categories, each containing one or more zones with the same primary land use permissions.", "code_refs": "none"}}}
