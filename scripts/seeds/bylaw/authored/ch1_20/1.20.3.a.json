 "rows": {"1.20.3(1)": {"explanation": "The zone symbol on the map, with any components that follow it, is called the zone label.", "code_refs": "none"}, "1.20.3(2)": {"explanation": "Every piece of land regulated by this by-law is outlined on the Zoning By-law Map and given a zone label using one of the zone symbols in Section 1.40.", "code_refs": "none"}, "1.20.3(3)": {"explanation": "A number after an x in round brackets in a zone label refers to site specific exception regulations for that lot or area in Chapter 900.", "code_refs": "none"}, "1.20.3(4)": {"explanation": "An H in round brackets before a zone symbol means development there is limited to what the exception in the zone label allows.", "code_refs": "none"}, "1.20.3(5)": {"explanation": "A zone boundary that falls in a public right-of-way extends to the centre line of that right-of-way.", "code_refs": "none"}, "1.20.3(6)": {"explanation": "If a lot is in more than one zone, each zone's regulations apply to the part of the lot inside that zone.", "code_refs": "none"}}}
