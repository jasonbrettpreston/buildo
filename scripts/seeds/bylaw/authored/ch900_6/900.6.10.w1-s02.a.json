  "rows": {
    "900.6.10(23)": {
      "explanation": "Exception RM 23 sets its own lot rules by building type: minimum lot area 230 m2 (detached), 460 m2 (semi-detached), 555 m2 (duplex), 610 m2 (triplex); minimum lot frontage 7.5 m (detached), 15.0 m (semi-detached or duplex), 16.5 m (triplex); a 9.5 m maximum height for a detached house; minimum side yard setbacks of 0.6 m (detached) and 1.2 m (semi-detached, duplex, triplex), and 1.5 m from a street side lot line on a corner lot. For some Lake Shore Drive addresses, former Etobicoke by-law 1991-41 also prevails.",
      "code_refs": "none"
    },
    "900.6.10(263)": {
      "explanation": "Exception RM 263 sets minimum lot area (230 / 465 / 555 m2) and frontage (7.5 / 15.0 / 18.0 m) for a detached house, semi-detached house and duplex, maximum lot coverage of 35% (detached, semi-detached) or 30% (duplex), a maximum height of 8.5 m and two storeys, minimum side yard setbacks of 0.9 / 1.2 / 2.4 m, and does not permit a triplex, fourplex or apartment building.",
      "code_refs": "none"
    },
    "900.6.10(383)": {
      "explanation": "Exception RM 383 permits a maximum lot coverage of 40%; the former North York Airport Hazard Map (Schedule 'D', by-law 7625) also prevails on these lands.",
      "code_refs": "none"
    }
  }
