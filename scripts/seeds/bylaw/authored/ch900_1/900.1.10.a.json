  "rows": {
    "900.1.10(1)": {
      "explanation": "Chapter 900 covers lands whose zone label on the Zoning By-law Map shows an exception number (an x with a number). An exception consists of Site Specific Provisions written in Sections 900.2 to 900.50, a Prevailing By-law or By-laws, or a Prevailing Section or Sections of a Former General Zoning By-law. A Prevailing By-law or Section is not a Site Specific Provision.",
      "code_refs": "none"
    },
    "900.1.10(2)": {
      "explanation": "Where a property has a Chapter 900 exception, all regulations of the By-law apply, including the exception.",
      "code_refs": "none"
    },
    "900.1.10(3)": {
      "explanation": "Site Specific Provisions in Chapter 900 take priority over any conflicting regulation in Chapters 5 to 800.",
      "code_refs": "none"
    },
    "900.1.10(4)": {
      "explanation": "A building or use that complies with a Prevailing By-law or Prevailing Section is not blocked by conflicting Chapter 5 to 800 regulations. New buildings, additions, enlargements and uses not permitted by the prevailing provision must meet all applicable regulations of this By-law. The Former General Zoning By-laws only help interpret the prevailing provisions and never outrank this By-law.",
      "code_refs": "none"
    }
  }
