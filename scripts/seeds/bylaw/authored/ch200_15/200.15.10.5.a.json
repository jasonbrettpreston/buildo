 "rows": {
  "200.15.10.5(1)": {"explanation": "Accessible parking spaces must be provided on the same lot, at the greater of the Table rate or the percentage-of-provided-parking shares in (A) to (E): 7 percent for residential uses in Parking Zone A, 5 percent elsewhere, 10 percent for medical offices and clinics, 5 percent for all other uses, with fractions rounded up.", "code_refs": "none"},
  "200.15.10.5(2)": {"explanation": "Where a lot has several uses, the accessible parking rate for each use applies and the required total is the sum of all of them.", "code_refs": "none"},
  "200.15.10.5(3)": {"explanation": "Where the Table sets a minimum number of accessible spaces for a use, the accessible spaces provided for that use may not be fewer than that minimum.", "code_refs": "none"},
  "200.15.10.5(4)": {"explanation": "The parking calculation and interpretation regulations 200.5.1.10(7), (8) and (11) and 200.5.10.1(8), (9) and (10) also apply when working out the minimum accessible spaces.", "code_refs": "none"}
 }}
