  "rows": {
    "10.5.100.1(1)": {"explanation": "In the Residential zones, a front-yard driveway for a detached house, semi-detached house, duplex or townhouse unit with its own private driveway must be at least 2.0 m wide. The maximum is 2.6 m for narrow lots (under 6.0 m frontage). For 6.0 to 23.0 m frontage it is the lesser of 6.0 m and the parking widths. Above 23.0 m it is the lesser of 9.0 m and the parking widths.", "code_refs": "none"},
    "10.5.100.1(2)": {"explanation": "A driveway that is not in or through the front yard must be at least 2.0 m wide, and no wider than the lesser of 6.0 m and the width of the parking spaces.", "code_refs": "none"},
    "10.5.100.1(3)": {"explanation": "For houseplexes with three or more dwelling units, and townhouses without individual private driveways, a driveway must be at least 2.0 m wide for each lane and no more than 6.0 m wide in total.", "code_refs": "none"},
    "10.5.100.1(6)": {"explanation": "A lot may have a driveway with two vehicle access points to the same street only if its frontage is over 18.0 m and the front yard landscaping complies with Clause 10.5.50.10.", "code_refs": "none"},
    "10.5.100.1(7)": {"explanation": "A residential lot may have a hammerhead turnaround driveway if front yard landscaping complies with Clause 10.5.50.10 and either the frontage exceeds 18.0 m or access is from a street with a right-of-way of at least 27.0 m. Large apartment buildings are excluded.", "code_refs": "none"},
    "10.5.100.1(8)": {"explanation": "A hammerhead turnaround may be at most 3.0 m wide, extend no more than 4.5 m from one driveway edge and no more than 3.0 m from each opposite edge.", "code_refs": "none"}
  }
