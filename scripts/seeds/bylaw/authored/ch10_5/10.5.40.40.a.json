 "rows": {
  "10.5.40.40(1)": {"explanation": "In a house (not an apartment building), attic space counts as floor area if it has more than 1.4 m of headroom between joists and rafters, and at least 80% of it has more than 2.0 m of headroom and is at least 10.0 m2.", "code_refs": "none"},
  "10.5.40.40(2)": {"explanation": "Attic space used for mechanical equipment is not counted as floor area if it is no more than 5% of the permitted floor area, up to 20 m2.", "code_refs": "none"},
  "10.5.40.40(3)": {"explanation": "When calculating floor area for a house, you may leave out the basement and tall double-height voids (up to 10% of permitted floor area). You may also leave out one parking space per unit, plus one more for a detached house on a lot more than 12.0 m wide.", "code_refs": "none"},
  "10.5.40.40(5)": {"explanation": "Floor space index is the counted floor area divided by the lot area. For a house, it includes qualifying attic space and leaves out the allowed deductions.", "code_refs": "none"}
