 "rows": {
  "10.5.50.10(1)": {"explanation": "Front yard landscaping for houses, houseplexes and townhouses depends on frontage. Under 6.0 m (or a townhouse unit under 6.0 m wide), the whole front yard except a permitted driveway or parking pad is landscaping. From 6.0 m to under 15.0 m, at least 50 percent; at 15.0 m or more, at least 60 percent. At least 75 percent of the required landscaping must be soft landscaping.", "code_refs": "none"},
  "10.5.50.10(2)": {"explanation": "A corner lot with these building types needs at least 60 percent of the side yard abutting a street landscaped, and at least 75 percent of that landscaping must be soft landscaping.", "code_refs": "none"},
  "10.5.50.10(3)": {"explanation": "A lot with a residential building other than an apartment building needs at least 50% of the rear yard in soft landscaping if frontage is over 6.0 m, or 25% if frontage is 6.0 m or less.", "code_refs": "none"},
  "10.5.50.10(6)": {"explanation": "When measuring landscaping, the setback area covered by permitted encroachments and the area covered by public utility equipment are left out.", "code_refs": "none"},
  "10.5.50.10(7)": {"explanation": "The water surface of outdoor swimming pools, fountains and artificial ponds counts as soft landscaping for the rear yard and related soft landscaping calculations.", "code_refs": "none"}
 }}
