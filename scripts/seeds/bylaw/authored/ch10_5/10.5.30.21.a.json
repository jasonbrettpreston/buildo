 "rows": {
  "10.5.30.21(1)": {"explanation": "If a lawfully existing lot has less frontage than the zone requires, its lawful lot frontage becomes the minimum for that lot.", "code_refs": "none"},
  "10.5.30.21(2)": {"explanation": "An addition or extension to a building on such a lot must meet all other regulations or get a Section 45 minor variance.", "code_refs": "none"},
