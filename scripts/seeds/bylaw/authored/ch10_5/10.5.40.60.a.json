  "rows": {
    "10.5.40.60(1)": {
      "explanation": "In residential zones, decks, porches and balconies may project into required yards: at or below the first storey up to 2.5 m (or half the setback) in front and rear yards and 1.5 m in side yards; above the first storey up to 1.5 m (or half the setback) front and rear, and into a side yard only where it faces a street. Each keeps a set distance from the side lot line.",
      "code_refs": "none"
    },
    "10.5.40.60(2)": {
      "explanation": "A roof or canopy over a permitted deck may project as far as the deck. Other canopies and awnings may project the lesser of 2.5 m or half the setback into front and rear yards, or 1.5 m into a side yard, keeping clear of the side lot line.",
      "code_refs": "none"
    },
    "10.5.40.60(3)": {
      "explanation": "Exterior stairs (no wider than 2.0 m), uncovered ramps (segments no wider than 1.5 m) and small elevating devices (up to 3.0 square metres, first floor only) may sit in required yards if they stay at least 0.6 m from a lot line.",
      "code_refs": "none"
    },
    "10.5.40.60(4)": {
      "explanation": "New cladding over an existing wall may project up to 0.15 m into a required yard (keeping 0.3 m from the lot line), or up to 0.9 m on lots with 100 or more units.",
      "code_refs": "none"
    },
    "10.5.40.60(5)": {
      "explanation": "Decorative features such as cornices and sills, and chimney breasts up to 2.0 m wide, may project up to 0.6 m into required yards if they stay 0.3 m from the lot line.",
      "code_refs": "none"
    },
    "10.5.40.60(6)": {
      "explanation": "Bay and box windows may project up to 0.75 m into front or rear yards (covering at most 65% of the wall width) and 0.6 m into side yards (at most 30% of the wall width, 0.6 m from the lot line).",
      "code_refs": "none"
    },
    "10.5.40.60(7)": {
      "explanation": "Dormer walls may not project into required setbacks; roof eaves may project up to 0.9 m if they stay 0.3 m from the lot line.",
      "code_refs": "none"
    },
    "10.5.40.60(8)": {
      "explanation": "Wall-mounted equipment may project into required yards if it stays 0.3 m from the lot line: vents and pipes 0.6 m (rear/side), satellite dishes 0.9 m, antennas 0.9 m (rear/side), air conditioners 0.9 m (rear, or side if not above the first storey), and utility meters without a stated limit.",
      "code_refs": "none"
    }
  }
