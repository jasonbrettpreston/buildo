 "rows": {
  "10.5.80.10(1)": {"explanation": "A parking space must be on the same lot as the use it is required for.", "code_refs": "none"},
  "10.5.80.10(10)": {"explanation": "A parking space outside of a building may not be used for commercially licensed vehicles, construction vehicles, dump trucks, agricultural vehicles, repair or towing vehicles, tracked vehicles, vehicles with a traction engine, rail-only vehicles, or vehicles with more than six wheels (spares excluded).", "code_refs": "none"},
  "10.5.80.10(3)": {"explanation": "A parking space may not be in a front yard or a side yard abutting a street, unless the City of Toronto permits front yard parking under the City of Toronto Act, 2006 or its predecessor.", "code_refs": "none"},
  "10.5.80.10(4)": {"explanation": "For a detached house, semi-detached house, duplex, or a townhouse unit with a private driveway leading directly to it, vehicles may be parked on the private part of the driveway that leads to a parking space.", "code_refs": "none"},
  "10.5.80.10(5)": {"explanation": "A parking space for a secondary suite may be in the front yard if it is on a driveway, despite the street-yard parking ban.", "code_refs": "none"},
  "10.5.80.10(6)": {"explanation": "On a corner lot a parking space must be in a building or structure, in a rear yard, or in a side yard that does not abut a street.", "code_refs": "none"},
  "10.5.80.10(7)": {"explanation": "On a lot with a detached house, semi-detached house or duplex, at most 2 parking spaces may be outside in the rear yard.", "code_refs": "none"},
  "10.5.80.10(8)": {"explanation": "Up to two parking spaces on a lot may be used for recreational vehicles, with no more than one camper trailer or one boat trailer, stored in a building or in a rear yard space not needed for soft landscaping.", "code_refs": "none"},
  "10.5.80.10(9)": {"explanation": "A parking space may hold a commercial vehicle if the owner or operator is an owner or tenant of a dwelling unit on the lot and the vehicle is in a wholly enclosed building.", "code_refs": "none"}
 }}
