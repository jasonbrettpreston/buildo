 "rows": {
  "10.5.20.40(1)": {"explanation": "A detached house in the Residential Zone category can be converted to a detached houseplex and still count as lawfully existing, if the extra dwelling units fit entirely inside the building as it lawfully existed the day before the building permit.", "code_refs": "none"},
  "10.5.20.40(2)": {"explanation": "One half of a semi-detached house can be converted to a semi-detached houseplex. The converted half is treated as a houseplex and the other half keeps its original building type, when applying the by-law standards.", "code_refs": "none"},
  "10.5.20.40(3)": {"explanation": "A portion of a townhouse on one lot can be converted to up to four dwelling units. For the listed regulations it may be treated as a duplex, triplex or fourplex; the rest of the townhouse keeps its original type.", "code_refs": "none"},
  "10.5.20.40(4)": {"explanation": "An addition or extension to a converted lawfully existing building must meet all other regulations or get a Section 45 minor variance.", "code_refs": "none"},
  "10.5.20.40(5)": {"explanation": "For these conversion rules, lawful and lawfully existing also cover buildings, structures or uses authorized or permitted on or before June 26, 2025, and buildings with a building permit lawfully issued before that date.", "code_refs": "none"},
  "10.5.20.40(6)": {"explanation": "A secondary suite is not allowed in the part of a semi-detached house or townhouse converted to contain up to four dwelling units.", "code_refs": "none"},
  "10.5.20.40(7)": {"explanation": "Lawful parking spaces in a lawfully existing building can be reduced to add dwelling units if the front or street-side driveway is removed and landscaped, or if a street-yard parking space is permitted under 10.5.80.10(3) or by minor variance.", "code_refs": "none"}
 }}
