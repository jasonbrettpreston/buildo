  "rows": {
    "10.10.20.40(1)": {
      "explanation": "In the R zone, homes (dwelling units) may be built as a detached house, semi-detached house, townhouse, detached houseplex, semi-detached houseplex or apartment building. Item (F) was deleted and no longer applies.",
      "code_refs": "none"
    },
    "10.10.20.40(2)": {
      "explanation": "Even where a site-specific exception (Chapter 900) lists fewer building types, a detached houseplex, semi-detached houseplex, townhouse or apartment building is still permitted in the R zone as long as it meets the R zone rules and the rest of the By-law, or receives a minor variance.",
      "code_refs": "none"
    }
