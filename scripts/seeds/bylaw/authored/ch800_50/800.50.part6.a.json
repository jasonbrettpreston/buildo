"rows":{
"800.50(780)":{"explanation":"Soft Landscaping is landscaping that leaves out hard-surfaced areas such as decorative stonework, retaining walls and walkways.","code_refs":"none"},
"800.50(785)":{"explanation":"Software Development and Processing is premises used for software development and testing, or for collecting, analysing, processing, storing or distributing electronic data.","code_refs":"none"},
"800.50(790)":{"explanation":"Solar Energy is energy from the sun that is converted into electrical or thermal energy.","code_refs":"none"},
"800.50(795)":{"explanation":"A Sports Place of Assembly is premises used for spectator sporting events, such as a stadium or arena.","code_refs":"none"},
"800.50(80)":{"explanation":"A basement is any part of a building whose floor-to-joist midpoint is lower than established grade (in the Residential and Residential Apartment zone categories) or lower than the average ground elevation along the front lot line (in all other zone categories).","code_refs":"none"},
"800.50(800)":{"explanation":"A Stable is premises used for keeping, boarding, training or breeding horses, mules or other equine animals.","code_refs":"none"},
"800.50(805)":{"explanation":"A Stacked Bicycle Parking Space is a horizontal bicycle space above or below another, with a mechanical device giving floor-level access to both.","code_refs":"none"},
"800.50(810)":{"explanation":"A Stacked Parking Space is a parking space above or below another and reached only by an elevating device.","code_refs":"none"},
"800.50(820)":{"explanation":"A storey is a level of a building, other than a basement, between any floor and the floor, ceiling or roof above it.","code_refs":"none"},
"800.50(825)":{"explanation":"A Street is a public right-of-way for general traffic circulation.","code_refs":"none"},
"800.50(83)":{"explanation":"A bedroom is a room in a dwelling unit with a window or other natural light source, used or designed mainly for sleeping; a dwelling room in a multi-tenant house is not a bedroom.","code_refs":"none"},
"800.50(830)":{"explanation":"A Street Yard is any front, rear or side yard abutting a street.","code_refs":"none"},
"800.50(835)":{"explanation":"A Structure is anything erected, built or constructed of joined parts; a vehicle is not a structure.","code_refs":"none"},
"800.50(840)":{"explanation":"A Student Residence is premises owned and operated by a school or educational facility, made up of dwelling units, bed-sitting rooms or rooms used for student accommodation.","code_refs":"none"},
"800.50(845)":{"explanation":"A Take-out Eating Establishment is premises where food or beverages are prepared and sold for consumption off the premises.","code_refs":"none"},
"800.50(85)":{"explanation":"A Bed-Sitting Room is a room used as separate living accommodation that has a private entrance from an interior hallway and may have sanitary but not food preparation facilities.","code_refs":"none"},
"800.50(850)":{"explanation":"A Tandem Parking Space is a parking space reached only by passing through another parking space from a street, lane, drive aisle or driveway.","code_refs":"none"},
"800.50(855)":{"explanation":"A Through Lot is a lot, other than a corner lot, that abuts more than one street or abuts one street in more than one location.","code_refs":"none"},
"800.50(860)":{"explanation":"A Tourist Home is a use in the operator's principal-residence dwelling unit that offers sleeping accommodation to the travelling public and may include meals.","code_refs":"none"},
"800.50(865)":{"explanation":"A townhouse is a building with three or more dwelling units where no unit is wholly or partly above another; houses with secondary suites and houseplexes are not townhouses.","code_refs":"none"},
"800.50(870)":{"explanation":"A Transportation Use is the use of premises or facilities to operate a mass transit or transportation system provided by or for the City, Province or Government of Canada, or privately operated and federally regulated.","code_refs":"none"},
"800.50(875)":{"explanation":"A triplex is a building with three dwelling units, at least one wholly or partly above another; it may be a type of detached or semi-detached houseplex, and houses or townhouses with secondary suites are not triplexes.","code_refs":"none"},
"800.50(88)":{"explanation":"Bicycle Maintenance Facilities are areas for bicycle repairs and maintenance that may include work space, a repair stand and an air pump.","code_refs":"none"},
"800.50(880)":{"explanation":"A Vehicle is a wheeled or tracked device, self-propelled or pulled, for moving persons or objects, or used for construction or agriculture.","code_refs":"none"},
"800.50(885)":{"explanation":"A Vehicle Dealership is premises used for the sale, rental or lease of vehicles displayed or stored on site, excluding construction or agricultural vehicles.","code_refs":"none"},
"800.50(890)":{"explanation":"A Vehicle Depot is premises for the non-public storing of vehicles, excluding construction or agricultural vehicles, and may include ancillary dispatching, maintenance, service and fuelling areas.","code_refs":"none"},
"800.50(895)":{"explanation":"A Vehicle Fuel Station is premises where vehicle fuels are sold to the public.","code_refs":"none"},
"800.50(90)":{"explanation":"A Bicycle Parking Space is an area used for parking or storing a bicycle.","code_refs":"none"},
"800.50(900)":{"explanation":"A Vehicle Repair Shop is premises used for vehicle service, repair or customizing, such as spray painting or repairing body or fender components.","code_refs":"none"},
"800.50(910)":{"explanation":"A Vehicle Service Shop is premises used for vehicle service or customizing, such as mechanical, electrical, glass or upholstery work, but excluding spray painting or body repair and servicing construction or agriculture vehicles.","code_refs":"none"},
"800.50(92)":{"explanation":"A Body Rub Service is premises offering services of rubbing, massaging or touching a person's body to appeal to erotic or sexual appetites; adult entertainment, massage therapy and wellness centres are not body rub services.","code_refs":"none"},
"800.50(920)":{"explanation":"A Veterinary Hospital is premises used by a licensed veterinarian for the medical treatment of animals.","code_refs":"none"},
"800.50(925)":{"explanation":"A Warehouse is premises for keeping or storing goods or commodities, not open to the general public, which may also be used for distributing them.","code_refs":"none"},
"800.50(937)":{"explanation":"A Wellness Centre is premises providing therapeutic and wellness services; a massage therapy, medical office or body rub service is not a wellness centre.","code_refs":"none"}
}}
