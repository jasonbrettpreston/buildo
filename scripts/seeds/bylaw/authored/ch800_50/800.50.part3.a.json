"rows":{
"800.50(375)":{"explanation":"Interior floor area is measured to the interior side of a main wall, the centreline of an interior wall, or a line delineating the part being measured.","code_refs":"none"},
"800.50(380)":{"explanation":"A kennel is premises used for boarding, training or breeding of dogs, cats or other domestic animals.","code_refs":"none"},
"800.50(390)":{"explanation":"A laboratory is premises used for scientific or technical research, analysis, experimentation or development.","code_refs":"none"},
"800.50(395)":{"explanation":"Landscaping is an area used for trees, plants, stonework, retaining walls, walkways or other landscape elements. Driveways and areas for loading, parking or storing vehicles do not count.","code_refs":"none"},
"800.50(400)":{"explanation":"A lane is a public right-of-way that is not for general traffic circulation.","code_refs":"none"},
"800.50(402)":{"explanation":"A laneway suite is a self-contained suite in an ancillary building abutting a lane. A garden suite is not a laneway suite.","code_refs":"none"},
"800.50(405)":{"explanation":"Lawful means authorized before a zoning by-law applied, compliant with the applicable former general zoning by-law, or authorized by a Section 45 minor variance.","code_refs":"none"},
"800.50(410)":{"explanation":"Lawfully existing means existing lawfully on May 9, 2013, or having a building permit lawfully issued before that date or within five years of it under the transition clauses.","code_refs":"none"},
"800.50(413)":{"explanation":"Level 2 Charging means a Level 2 electric vehicle charging level as defined by SAE International's J1772 standard.","code_refs":"none"},
"800.50(415)":{"explanation":"A loading space is an area used for loading or unloading goods or commodities from a vehicle.","code_refs":"none"},
"800.50(420)":{"explanation":"A lot is a single parcel or tract of land that may be conveyed in compliance with the Planning Act.","code_refs":"none"},
"800.50(425)":{"explanation":"Lot area is the horizontal area within all the lot lines of a lot.","code_refs":"none"},
"800.50(430)":{"explanation":"The lot centreline is a straight line joining the midpoint of the front lot line and the midpoint of the rear lot line.","code_refs":"none"},
"800.50(435)":{"explanation":"Lot coverage is the portion of the lot covered by any part of any building or structure on or above the surface of the lot.","code_refs":"none"},
"800.50(440)":{"explanation":"Lot depth is the horizontal distance between the front and rear lot lines, measured along the lot centreline.","code_refs":"none"},
"800.50(445)":{"explanation":"Lot frontage is the horizontal distance between the side lot lines, measured perpendicular to the lot centreline at the required minimum front yard setback.","code_refs":"none"},
"800.50(45)":{"explanation":"An angular plane is an imaginary flat surface projecting over a lot at an inclined angle up from the horizontal.","code_refs":"none"},
"800.50(450)":{"explanation":"A lot line is any boundary of a lot.","code_refs":"none"},
"800.50(455)":{"explanation":"A main wall is any exterior wall of a building or structure, including the structural members essential to supporting a roof over an enclosed area.","code_refs":"none"},
"800.50(457)":{"explanation":"A major street is any street identified as Major Streets on the Policy Areas Overlay Map in Section 995.10.","code_refs":"none"},
"800.50(460)":{"explanation":"Manufacturing use is the use of premises for fabricating, processing, assembling, packaging, producing or making goods, including repair of them.","code_refs":"none"},
"800.50(465)":{"explanation":"A market garden is premises used for growing and harvesting horticultural products for sale.","code_refs":"none"},
"800.50(467)":{"explanation":"Massage therapy is provided by licensed or registered health professionals. A body rub service or wellness centre is not massage therapy.","code_refs":"none"},
"800.50(470)":{"explanation":"A mausoleum is a building or structure, other than a columbarium, used for the interment of human remains.","code_refs":"none"},
"800.50(475)":{"explanation":"A mixed use building has a dwelling unit and a non-residential use. A residential building is not a mixed use building.","code_refs":"none"},
"800.50(478)":{"explanation":"A multi-tenant house has four or more dwelling rooms that may share sanitary and cooking facilities. Group homes, nursing homes, hotels and similar uses are excluded.","code_refs":"none"},
"800.50(480)":{"explanation":"A municipal shelter provides short-term emergency accommodation and support services and is operated by or for the City of Toronto.","code_refs":"none"},
"800.50(485)":{"explanation":"A museum is premises used to exhibit, collect or preserve objects of cultural, historical or scientific interest for public viewing.","code_refs":"none"},
"800.50(490)":{"explanation":"A nightclub provides amplified music for patron entertainment and dancing. Cabarets, eating establishments and places of assembly are not nightclubs.","code_refs":"none"},
"800.50(495)":{"explanation":"A non-profit organization is a corporation without share capital under Part III of the Corporations Act, or a non-profit, charitable organization or registered charity under the Income Tax Act.","code_refs":"none"},
"800.50(5)":{"explanation":"Adult entertainment is premises where nudity or partial nudity is a principal feature of entertainment designed to appeal to erotic or sexual appetites. A body rub service is not adult entertainment.","code_refs":"none"},
"800.50(50)":{"explanation":"An animal shelter is premises used for keeping, adopting or disposing of stray, abandoned or wild animals.","code_refs":"none"},
"800.50(500)":{"explanation":"A non-residential building is a building that does not have a dwelling unit.","code_refs":"none"}
}}
