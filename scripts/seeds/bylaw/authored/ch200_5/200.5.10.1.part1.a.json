 "rows": {
  "200.5.10.1(1)": {
   "explanation": "Table 200.5.10.1 sets parking rates by use; most are maximums, and rates vary by parking zone.",
   "code_refs": "none"
  },
  "200.5.10.1(10)": {
   "explanation": "Alternative housing means City-linked or non-profit housing for parking purposes.",
   "code_refs": "none"
  },
  "200.5.10.1(11)": {
   "explanation": "An outdoor patio may replace some required parking, with limits on resident and visitor spaces.",
   "code_refs": "none"
  },
  "200.5.10.1(12)": {
   "explanation": "Small apartment buildings on major streets in residential zones need just 1 visitor space.",
   "code_refs": "none"
  },
  "200.5.10.1(2)": {
   "explanation": "Parking provided must be between the required minimum and the permitted maximum.",
   "code_refs": "none"
  },
  "200.5.10.1(3)": {
   "explanation": "An ancillary use follows the parking rate of the use it serves.",
   "code_refs": "none"
  },
  "200.5.10.1(4)": {
   "explanation": "A use with no table rate may still have parking if it stays within the lot's minimum and maximum totals.",
   "code_refs": "none"
  },
  "200.5.10.1(5)": {
   "explanation": "With several uses, minimums add up and maximums add up.",
   "code_refs": "none"
  },
  "200.5.10.1(7)": {
   "explanation": "Table minimums and maximums are both binding, and no minimum means only accessible spaces are required.",
   "code_refs": "none"
  },
  "200.5.10.1(8)": {
   "explanation": "A multiple dwelling unit building is two or more residential buildings sharing a driveway over tied land.",
   "code_refs": "none"
  }
