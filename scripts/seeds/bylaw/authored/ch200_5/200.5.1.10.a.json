 "rows": {
  "200.5.1.10(1)": {
   "explanation": "Which parking zone rate applies to a lot depends on how much of the street frontage strip is covered by buildings.",
   "code_refs": "none"
  },
  "200.5.1.10(11)": {
   "explanation": "Mechanical, storage and parking areas do not count as gross floor area when working out required parking.",
   "code_refs": "none"
  },
  "200.5.1.10(13)": {
   "explanation": "Parking areas need direct, unobstructed driveway access to a street or lane, except stacked or tandem spaces.",
   "code_refs": "none"
  },
  "200.5.1.10(14)": {
   "explanation": "Parking spaces need electric vehicle charging outlets: Level 2 for housing and suites, 25 percent of spaces otherwise.",
   "code_refs": "none"
  },
  "200.5.1.10(2)": {
   "explanation": "A standard parking space has set minimum length, width and clearance, with wider sizes beside obstructions or narrow aisles.",
   "code_refs": "none"
  },
  "200.5.1.10(3)": {
   "explanation": "A parking space may be no longer than 6.0 m and no wider than 3.2 m.",
   "code_refs": "none"
  },
  "200.5.1.10(4)": {
   "explanation": "Minimum vertical clearance covers the whole parking space except for a low wheel stop.",
   "code_refs": "none"
  },
  "200.5.1.10(5)": {
   "explanation": "A required space may not be tandem, except for a secondary suite, group home or duplex.",
   "code_refs": "none"
  },
  "200.5.1.10(6)": {
   "explanation": "A tandem space must be at least 5.6 m long, 2.6 m wide and 2.0 m clear.",
   "code_refs": "none"
  },
  "200.5.1.10(7)": {
   "explanation": "Parking for vacant space follows its previous use, its permitted use, or the zone's highest-demand use.",
   "code_refs": "none"
  },
  "200.5.1.10(8)": {
   "explanation": "Where the rate is per gross floor area, the requirement is that area times the table rate.",
   "code_refs": "none"
  },
  "200.5.1.10(9)": {
   "explanation": "Required parking is rounded down, but never below one space.",
   "code_refs": "none"
  }
 }
