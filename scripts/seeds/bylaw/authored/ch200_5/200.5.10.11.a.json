 "rows": {
  "200.5.10.11(1)": {
   "explanation": "A lawfully existing building keeps its lawful parking count, even if that is below the minimum or above the maximum, and may not reduce it.",
   "code_refs": "none"
  },
  "200.5.10.11(2)": {
   "explanation": "Additions to such a building must add the extra parking required, up to the maximum, unless a minor variance is granted.",
   "code_refs": "none"
  },
  "200.5.10.11(3)": {
   "explanation": "On a change of use the existing parking may not be reduced and added parking must be provided or varied.",
   "code_refs": "none"
  },
  "200.5.10.11(4)": {
   "explanation": "Lawful off-site parking may stay if not reduced, and additions must comply or be varied.",
   "code_refs": "none"
  },
  "200.5.10.11(5)": {
   "explanation": "Lawful also covers things authorized before February 3, 2022 and afterwards under the listed clauses.",
   "code_refs": "none"
  }
 }
