 "rows": {
  "900.3.10(195)": {
   "explanation": "Exception RD 195 sets a 1.2 m minimum side yard and a 4.5 m minimum flankage setback, a 22.0 m setback from the centreline of Brimley Rd., requires compliance with exception 1462, and points to a former Scarborough by-law on Anson Avenue.",
   "code_refs": "none"
  },
  "900.3.10(448)": {
   "explanation": "Exception RD 448 sets centreline-based setbacks on named roads, a 0.9 m side setback, 5.7 m flankage setback, a 0.3 m garage setback from an interior side lot line, and requires compliance with exception 1462.",
   "code_refs": "none"
  },
  "900.3.10(1404)": {
   "explanation": "Exception RD 1404 stops raised platforms from encroaching into front or rear yard setbacks, and points to former City of Toronto by-laws on Heath St. W. and Montclair Ave.",
   "code_refs": "none"
  },
  "900.3.10(171)": {
   "explanation": "Exception RD 171 allows a 0.3 m side setback on one side and 0.9 m on the other, a 3.0 m flankage setback, and 45% maximum lot coverage.",
   "code_refs": "none"
  },
  "900.3.10(203)": {
   "explanation": "Exception RD 203 keeps the lot frontage and area that existed on the enactment day as the minimums, sets a 0.9 m side setback and 3.6 m flankage setback, and requires compliance with exception 1462.",
   "code_refs": "none"
  }
 }
