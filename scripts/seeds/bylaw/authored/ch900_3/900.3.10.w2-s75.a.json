 "rows": {
  "900.3.10(854)": {
   "explanation": "Exception RD 854 sets site-specific rules: lot frontage and area as they existed when By-law 569-2013 was enacted; front setback 7.5 m beside Middlefield Rd. or McNicoll Ave. and 6.0 m elsewhere; side setback 0.9 m (7.5 m or 3.0 m on a street side); garage entrances facing the street 6.0 m back; garage side setback 0.3 m; 45% lot coverage; required parking inside a building; and compliance with exception 1462.",
   "code_refs": "none"
  },
  "900.3.10(1419)": {
   "explanation": "Exception RD 1419 allows replacement of a pre-1977 building no taller than the one replaced, a rear addition (FSI up to 0.69) to a detached house erected before October 15, 1953 under conditions, bars higher-than-first-floor platforms from encroaching into front or rear yards, bars front-wall vehicle entrances on lots 7.6 m wide or less, and keeps former by-laws for named Chaplin Cres. and Spadina Rd. addresses.",
   "code_refs": "none"
  }
 }
