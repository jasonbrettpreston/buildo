 "rows": {
  "900.3.10(408)": {
   "explanation": "Exception RD 408 sets site-specific setbacks: 22.0 m from the street centreline on three named roads, 0.9 m from a side lot line, 5.7 m on a street side, and 0.3 m for a garage. The lands must also comply with exception 1462.",
   "code_refs": "none"
  },
  "900.3.10(1091)": {
   "explanation": "Exception RD 1091 keeps the lot frontage and lot area that existed when the by-law was enacted, sets front setbacks of 7.5 m (Corinthian Boulevard) or 6.0 m, side setbacks of 1.2 m and 4.5 m on a street side, 0.3 m for a garage, requires the parking space in the residential building, and applies exception 1462.",
   "code_refs": "none"
  },
  "900.3.10(559)": {
