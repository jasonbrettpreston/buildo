"rows": {
 "900.3.10(143)": {"explanation": "Exception RD 143 keeps each lot's frontage and area as they were in 2013 as the minimums, sets a 0.9 m side yard setback and a 2.4 m setback from a street-side lot line, and requires larger setbacks measured from the street centreline (22.0 m on Birchmount Rd., 16.0 m elsewhere; 15.5 m from Birchmount Rd. for a side lot line).", "code_refs": "none"},
 "900.3.10(87)": {"explanation": "Exception RD 87 keeps each lot's frontage and area as they were in 2013 as the minimums, sets a 1.2 m side yard setback, a 5.7 m setback from a street-side lot line and a 0.3 m side setback for garages; at 920 Bellamy Road North a former Scarborough by-law provision also prevails.", "code_refs": "none"},
 "900.3.10(696)": {"explanation": "Exception RD 696 keeps each lot's frontage and area as they were in 2013 as the minimums, sets a 1.0 m side yard setback (none on the south side of Ponymeadow Terrace), a 3.0 m street-side setback, a 6.0 m setback for street-facing garage entrances, 40% maximum lot coverage, parking inside a building, and also applies exception 900.3.10(1462).", "code_refs": "none"}
}
