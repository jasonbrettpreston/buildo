  "rows": {
    "900.3.10(971)": {
      "explanation": "Exception RD 971 sets site-specific rules for the RD zone: a 9.14 metre minimum front yard setback for a detached house on Registered Plan M-809, a 9.5 metre height cap for detached houses with a low-slope roof where 3 storeys is permitted, an exemption for upper-storey balconies, porches and sundecks set back the greater of the required setback or 6.0 metres, a 5% lot coverage cap and a 100 square metre floor area cap for ancillary buildings. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(9)": {
      "explanation": "Exception RD 9 sets site-specific rules for the RD zone: lot coverage of 28% (lot area 510 square metres or less) or 25% otherwise, excluding a garage; a 38 square metre cap on an attached garage; a detached house floor space index of 0.33 or 0.30 by lot area; side yard setbacks of 1.0 metre (2.4 metres aggregate) for lots 15.2 metres wide or less and 1.2 metres (3.0 metres aggregate) otherwise, with a special rule for additions to houses existing at enactment; and floor space index caps of 0.33 for 19 Barker Ave. and 0.34 for 37 Gibson Ave. No prevailing by-laws apply.",
      "code_refs": "none"
    }
  }
}
