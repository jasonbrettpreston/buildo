"900.3.10(586)":{"explanation":"Exception RD 586 sets a 1.0 m side setback on one side, 3.0 m from lot lines abutting a street, a 6.0 m setback for a garage entrance facing the street, 50 percent maximum lot coverage, and at most 3 parking spaces in a garage.","code_refs":"none"},
