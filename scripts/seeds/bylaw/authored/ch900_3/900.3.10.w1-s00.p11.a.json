  "rows": {
    "900.3.10(21)": {
      "explanation": "Exception RD 21 sets site-specific rules: a 6.5 m height limit for flat-roofed detached houses; building depth includes the permitted one-storey extension; gross floor area of 135 m2 plus 25% of the lot area, up to an FSI of 0.5, counting garages and void areas (void areas count double, with up to 4% excludable); side yard setbacks for 2+ storey detached houses that rise with lot frontage; and garages for 3 or more vehicles only on lots wider than 27.0 m. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(42)": {
      "explanation": "Exception RD 42 permits a detached house if its gross floor area, including any garage, is no more than 118 m2 plus 25% of the lot area (up to an FSI of 0.5), and lets a second-storey addition over an existing bungalow on a lot narrower than 15.3 m keep the existing side yard setback if it is at least 0.6 m, with both side yards totalling at least 2.1 m. No prevailing by-laws apply.",
      "code_refs": "none"
    }
  }
