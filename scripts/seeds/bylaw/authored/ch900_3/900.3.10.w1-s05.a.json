"rows": {
 "900.3.10(37)": {"explanation": "Exception RD 37 sets a 6.5 m height limit for flat-roofed detached houses, caps gross floor area at 150 m2 plus 25% of the lot area (and FSI 0.5) with garages and doubled void areas counted, scales the detached-house side yard setback with lot frontage, and allows a 3-car garage on lots wider than 27 m.", "code_refs": "none"},
 "900.3.10(70)": {"explanation": "Exception RD 70 requires a 9 m front yard and a 1.8 m side yard (more for taller buildings), sets a special height rule for low-slope-roof detached houses, and limits ancillary buildings to 5% lot coverage and 100 m2 of floor area.", "code_refs": "none"},
 "900.3.10(169)": {"explanation": "Exception RD 169 requires a 4.5 m front yard, a 0.9 m side setback, a 4.5 m street-side setback, and 22.0 m from the centreline of Victoria Park Ave., Pharmacy Ave. or St Clair Ave E. for lots fronting those streets.", "code_refs": "none"}
}
