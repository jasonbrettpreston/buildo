    "900.3.10(355)": {"explanation": "Exception RD 355 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums, and sets a 0.9 m minimum side setback.", "code_refs": "none"},
    "900.3.10(628)": {"explanation": "Exception RD 628 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums. Side setbacks (0.6, 0.9 or 1.2 m) and setbacks from a lot line abutting a street (3.0 or 3.5 m) depend on lot frontage. Lot coverage is capped at 50% on lots under 438 square metres. An attached garage must be 0.3 m from a side lot line that does not abut a street, the required parking space must be inside the residential building, and exception 900.3.10(1462) also applies.", "code_refs": "none"},
    "900.3.10(157)": {"explanation": "Exception RD 157 sets a 22.0 m setback from the original centreline of Birchmount Rd., a 0.3 m minimum side setback, and a 1.5 m minimum setback from a side lot line abutting a street. Exception 900.3.10(1462) also applies.", "code_refs": "none"}
  }
