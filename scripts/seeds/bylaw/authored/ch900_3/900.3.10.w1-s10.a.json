  "rows": {
    "900.3.10(1104)": {
      "explanation": "Exception RD 1104 sets the minimum lot frontage and lot area to what existed when By-law 569-2013 was enacted, requires a 1.2 m setback from a side lot line and 4.5 m from a side lot line abutting a street, keeps a garage at least 0.3 m from a side lot line, requires the parking space to be inside the house, and also applies exception 1462. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(613)": {
      "explanation": "Exception RD 613 requires a 0.9 m setback from a side lot line, also applies exception 1462, and does not permit townhouses or apartment buildings on a lot abutting Lawrence Avenue East. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(285)": {
      "explanation": "Exception RD 285 sets the minimum lot frontage and lot area to what existed when By-law 569-2013 was enacted, requires a 22.0 m setback from the original centreline of Warden or Pharmacy Avenue, a 0.9 m side lot line setback and 3.6 m from a side lot line abutting a street, and lets the parking part of a building sit in a side yard if it is at least 0.3 m from the side lot line. No prevailing by-laws apply.",
      "code_refs": "none"
    }
