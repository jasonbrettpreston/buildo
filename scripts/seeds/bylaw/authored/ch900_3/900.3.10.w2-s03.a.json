  "rows": {
    "900.3.10(1056)": {
      "explanation": "Exception RD 1056 sets site-specific rules: the minimum lot frontage and lot area are those that existed when By-law 569-2013 was enacted, side setbacks of 1.2 m (4.5 m beside a street), a garage at least 0.3 m from a side lot line, the required parking space inside a building, and compliance with exception 900.3.10(1462). A 25.0 m setback from the original Finch Ave. centreline also applies on Finch Ave. lot lines. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(248)": {
      "explanation": "Exception RD 248 sets site-specific rules: the minimum lot frontage and lot area are those that existed when By-law 569-2013 was enacted, a 1.2 m minimum side yard setback, 5.7 m beside a street, and a 30.0 m setback from the original road allowance centreline on lot lines abutting Ellesmere Rd. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(288)": {
      "explanation": "Exception RD 288 sets site-specific rules: the minimum lot frontage and lot area are those that existed when By-law 569-2013 was enacted, a 0.9 m side setback (3.6 m beside a street), and a garage at least 0.3 m from a side lot line. At 20 Courton Drive, former Scarborough zoning by-law 9511, Schedule C Exception 60, prevails.",
