  "rows": {
    "900.3.10(5)": {"explanation": "Exception RD 5 sets a 1.8 m minimum side yard setback, switches off one regulation for 97 Hillmount Avenue, sets driveway and front-yard landscaping rules for the existing building at 2980 Weston Road, and keeps the former North York Airport Hazard Map in force.", "code_refs": "none"},
    "900.3.10(1462)": {"explanation": "Exception RD 1462 caps floor area by lot size: under 408 m2 the lesser of 0.6 x lot area or 204 m2; 408-697 m2 the lesser of 0.5 x lot area or 279 m2; over 697 m2, 0.4 x lot area. No prevailing by-laws apply.", "code_refs": "none"},
    "900.3.10(1463)": {"explanation": "Exception RD 1463 adds no site-specific rules; the former North York Airport Hazard Map prevails, and by-law 1295-2013 prevails on 716 Marlee Avenue and 692, 694 and 696 Glengrove Avenue.", "code_refs": "none"},
    "900.3.10(961)": {"explanation": "Exception RD 961 bars raised platforms (above the first floor) from encroaching into required front or rear yards, requires parking access from the lane or flanking street where the lot abuts one, and keeps a former Toronto by-law section in force on certain Rosewell Ave. and Avenue Rd. lots.", "code_refs": "none"}
