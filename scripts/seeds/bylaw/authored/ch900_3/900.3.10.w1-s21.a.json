"rows": {
 "900.3.10(927)": {"explanation": "Exception RD 927 keeps each lot's minimum frontage and area at what existed on May 9, 2013, sets a 1.2 m side setback (5.7 m on a street side), lets a garage sit 0.3 m from an interior side lot line, and applies exception 1462 too.", "code_refs": "none"},
 "900.3.10(1057)": {"explanation": "Exception RD 1057 keeps each lot's minimum frontage and area at what existed on May 9, 2013, requires 7.5 m from lot lines on Huntingwood Dr. or Chartland Blvd. S. and 6.0 m from other street lot lines, a 1.2 m interior side setback (4.5 m on a street side), lets a garage sit 0.3 m from an interior side lot line, requires the parking space to be inside a building, and applies exception 1462 too.", "code_refs": "none"},
 "900.3.10(156)": {"explanation": "Exception RD 156 requires buildings to be 22.0 m from the original centreline of Kennedy Rd., a 0.45 m side setback (2.4 m on a street side), and applies exception 1462 too; at 203 and 205 McIntosh St. a former Scarborough by-law provision also prevails.", "code_refs": "none"},
 "900.3.10(1199)": {"explanation": "Exception RD 1199 adds no site specific rules; provisions of former City of York by-laws 1-83 (Section 16(1)) and 12349 prevail on these lands.", "code_refs": "none"}
}
