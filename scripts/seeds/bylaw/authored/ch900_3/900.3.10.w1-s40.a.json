  "rows": {
    "900.3.10(302)": {
      "explanation": "Exception RD 302 keeps each lot's minimum frontage and area at what existed when By-law 569-2013 was enacted, requires a 30 m setback from the original centreline of Ellesmere Rd. for lots fronting it, sets minimum side setbacks of 0.9 m (3.6 m on a street side), and lets garages sit 0.3 m from an interior side lot line.",
      "code_refs": "none"
    },
    "900.3.10(247)": {
      "explanation": "Exception RD 247 keeps each lot's minimum frontage and area at what existed when By-law 569-2013 was enacted, requires a 22.0 m setback from the original centreline of Brimley Rd. for lots fronting it, sets minimum side setbacks of 1.2 m (5.7 m on a street side), lets garages sit 0.3 m from an interior side lot line, requires below-grade floors to sit 3.6 m above Highland Creek, and preserves provisions of former Scarborough by-law 9350.",
      "code_refs": "none"
    }
  }
