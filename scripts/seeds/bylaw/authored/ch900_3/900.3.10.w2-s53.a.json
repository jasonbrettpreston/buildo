  "rows": {
    "900.3.10(291)": {
      "explanation": "Exception RD 291 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted, sets side setbacks of 1.2 m (3.6 m on a street side), allows garages 0.3 m from a non-street side lot line, and has special setbacks tied to Warden Ave., Pharmacy Ave. and two named addresses. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(122)": {
      "explanation": "Exception RD 122 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted, sets side setbacks of 1.2 m (5.7 m on a street side), sets a Livingston Rd. setback from the road centreline, and requires compliance with exception 900.3.10(1462). No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.3.10(1389)": {
      "explanation": "Exception RD 1389 bars a platform higher than the first floor from encroaching into the required front or rear yard setback. The former City of Toronto By-law 438-86 prevails at the listed Hillcrest Dr addresses.",
