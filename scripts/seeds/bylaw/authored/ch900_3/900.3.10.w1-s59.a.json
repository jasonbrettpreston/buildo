  "rows": {
    "900.3.10(1322)": {"explanation": "Site-specific rules for RD exception 1322: a pre-1953 detached house on a lot with a permitted FSI of 0.6 may get a rear addition up to an overall FSI of 0.69, if the addition stays no higher than the existing top floor, no closer to the side lot line than the existing side wall, and any earlier addition is at least 5 years old. Raised front- or rear-yard platforms may not encroach into the required yard, and lots 7.6 m wide or narrower may not have a vehicle entrance through the front wall. A section of former By-law 438-86 also prevails.", "code_refs": "none"},
    "900.3.10(342)": {"explanation": "Site-specific rules for RD exception 342: minimum lot frontage and lot area are whatever existed when By-law 569-2013 was enacted; side setback 0.9 m, street-side setback 3.6 m, attached-garage portion at least 0.3 m from a side lot line; the basement floor must be at least 3.6 m above the Massey Creek invert.", "code_refs": "none"},
    "900.3.10(437)": {"explanation": "Site-specific rules for RD exception 437: buildings at least 22.0 m from the original centreline of Lawrence Ave.; side setback 0.9 m, street-side setback 3.6 m, garages at least 0.3 m from an interior side lot line; the lands must also comply with exception 900.3.10(1462).", "code_refs": "none"}
  }
