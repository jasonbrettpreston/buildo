"rows": {
"900.3.10(199)": {"explanation":"Exception RD 199 sets site-specific setbacks: 9.0 metres from the front line, 0.9 metres side yard, and 4.5 metres from a side lot line that abuts a street. The lands must also comply with exception 900.3.10(1462), and Schedule \"C\" Exceptions 5 and 13 of former Scarborough by-law 9396 may apply as an alternate path.","code_refs":"none"},
"900.3.10(256)": {"explanation":"Exception RD 256 sets a 1.2 metre minimum side yard setback and a 3.6 metre minimum setback from a side lot line that abuts a street. The lands must also comply with exception 900.3.10(1462). No prevailing by-laws apply.","code_refs":"none"},
"900.3.10(100)": {"explanation":"Exception RD 100 sets the minimum lot frontage and lot area to those existing when By-law 569-2013 was enacted, a 22.0 metre setback from the original road centreline on Scarborough Golf Club Rd., a 7.5 metre front setback where that rule does not apply, 1.2 metre side and 5.7 metre street-side setbacks, and 0.3 metres from a side lot line for a garage. Former Scarborough by-law 9510 may apply to named addresses.","code_refs":"none"},
"900.3.10(1428)": {"explanation":"Exception RD 1428 bars a vehicle entrance through the front wall of a residential building on a lot with 7.6 metres of frontage or less, bars higher platforms from encroaching into required front or rear yard setbacks, and requires additions above the first storey of a lawfully existing detached house to meet the minimum setbacks. Sections 12(2) 107 and 12(2) 108 of former Toronto By-law 438-86 may apply as alternate paths.","code_refs":"none"}
}
}
