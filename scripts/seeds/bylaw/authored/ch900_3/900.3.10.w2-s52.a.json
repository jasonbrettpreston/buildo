"rows": {
"900.3.10(975)": {"explanation": "Exception RD 975 sets a 15.0 metre front yard setback from Fifeshire Rd. and 18.0 metres from Bayview Ave., a stepped side yard setback by storey, a 9.5 metre height limit for low-slope roofs on a detached house where 3 storeys is permitted, a 5 percent lot coverage cap and 100 square metres total floor area for ancillary buildings. No prevailing by-laws apply.", "code_refs": "none"},
"900.3.10(1401)": {"explanation": "Exception RD 1401 lets a detached house erected before October 15, 1953 on a lot with a permitted floor space index of 0.6 be enlarged by a rear addition up to an overall floor space index of 0.69, subject to conditions on floor levels, side wall position and the age of prior additions. A platform higher than the first floor may not encroach into the required front or rear yard setback, and a lot with 7.6 metres or less of frontage may not have a vehicle entrance through the front wall of a residential building. Former City of Toronto By-law 438-86 sections 12(2) 118 and 119 prevail.", "code_refs": "none"},
"900.3.10(241)": {"explanation": "Exception RD 241 sets the minimum required lot frontage and lot area at what existed on the date of enactment of the By-law, a 1.2 metre side yard setback, a 5.7 metre setback from a side lot line abutting a street, and a 0.3 metre setback for an attached or detached garage from a side lot line that does not abut a street. No prevailing by-laws apply.", "code_refs": "none"}
}
}
