"900.3.10(130)":{"explanation":"Exception RD 130 sets the minimum lot frontage and lot area to what existed on the day By-law 569-2013 was enacted, a 1.2 metre side setback, a 5.7 metre setback on a side lot line that abuts a street, and a 22 metre setback from the original road centreline for Guildwood Parkway. It also brings in exception 900.3.10(1462).","code_refs":"none"},
"900.3.10(125)":{"explanation":"Exception RD 125 sets the minimum lot frontage and lot area to what existed on the day By-law 569-2013 was enacted, a 1.2 metre side setback and a 5.7 metre setback on a side lot line that abuts a street. It also brings in exception 900.3.10(1462).","code_refs":"none"},
"900.3.10(419)":{"explanation":"Exception RD 419 sets the minimum lot frontage and lot area to what existed on the day By-law 569-2013 was enacted, a 1.2 metre side setback and a 5.7 metre setback on a side lot line that abuts a street.","code_refs":"none"},
"900.3.10(543)":{"explanation":"Exception RD 543 sets the minimum lot frontage and lot area to what existed on the day By-law 569-2013 was enacted, a 50 percent maximum lot coverage, a 3.5 metre setback on a side lot line that abuts a street, a 1.0 metre side setback, and requires the required parking space to be in the residential building.","code_refs":"none"}}}
