  "rows": {
    "900.3.10(516)": {"explanation": "Exception RD 516 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted, sets front building setbacks of 18.0, 12.0 or 7.5 metres depending on the street the front lot line abuts, a 1.2 metre side setback, and a 0.3 metre side setback for garages.", "code_refs": "none"},
    "900.3.10(814)": {"explanation": "Exception RD 814 sets a 12.0 metre minimum lot frontage for corner lots, side setbacks of 0.9 metres (4.5 metres next to a street), a 45 percent lot coverage maximum, requires the parking space to be inside the residential building, and brings in exception 900.3.10(1462).", "code_refs": "none"},
    "900.3.10(338)": {"explanation": "Exception RD 338 sets a 35 percent lot coverage maximum and larger rear yard setbacks (13.0 to 15.5 metres by storey) for the named Bayview Ave. and Bowan Crt./Ct. addresses.", "code_refs": "none"}
