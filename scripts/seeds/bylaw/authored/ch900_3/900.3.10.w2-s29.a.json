  "rows": {
    "900.3.10(251)": {"explanation": "Exception RD 251 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums, sets a 1.2 metre minimum side yard setback and a 5.7 metre minimum setback from a side lot line that abuts a street, and sets a 22.0 metre front setback from the original road allowance centreline on McCowan Rd. No prevailing by-laws apply.", "code_refs": "none"},
    "900.3.10(128)": {"explanation": "Exception RD 128 sets a 15.0 metre minimum lot frontage for a corner lot, a 22.0 metre setback from the original centreline of Morningside Ave., a side setback of 0.9 metres for the named even numbered lots on Poplar Rd. and 1.2 metres otherwise, and 5.7 metres from a side lot line that abuts a street. The lands must also comply with exception 900.3.10(1462). No prevailing by-laws apply.", "code_refs": "none"},
    "900.3.10(315)": {"explanation": "Exception RD 315 keeps the lot frontage and lot area that existed when By-law 569-2013 was enacted as the minimums, sets a 1.2 metre minimum side setback and 5.7 metres from a side lot line that abuts a street, and requires garages to be at least 0.3 metres from a side lot line that does not abut a street. On named lots on Cloverleaf Gate and Lowcreast Blvd. a detached garage is not permitted in a rear yard, and 38 Lowcreast Blvd. has a 4.5 metre side street setback. No prevailing by-laws apply.", "code_refs": "none"}
  }
