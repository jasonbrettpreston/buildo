"900.3.10(196)":{"explanation":"Exception RD 196 keeps the lot frontage and lot area the lot had when the zoning by-law was enacted, sets a 1.2 metre side yard setback and a 5.7 metre setback from a side lot line that abuts a street, sets a 22.0 metre setback from the original road centreline along Brimley Rd. and St. Clair Ave., and requires compliance with exception 1462.","code_refs":"none"},
"900.3.10(1066)":{"explanation":"Exception RD 1066 keeps the lot frontage and lot area the lot had when the zoning by-law was enacted, sets a 1.2 metre side setback and a 4.5 metre setback from a side lot line that abuts a street, keeps a garage at least 0.3 metres from a side lot line, requires the required parking space to be in the residential building, and requires compliance with exception 1462.","code_refs":"none"},
"900.3.10(440)":{"explanation":"Exception RD 440 keeps the lot frontage and lot area the lot had when the zoning by-law was enacted, sets a 1.2 metre side setback and a 5.7 metre setback from a side lot line that abuts a street, keeps an attached or detached garage at least 0.3 metres from a side lot line that does not abut a street, and requires compliance with exception 1462.","code_refs":"none"}}}
