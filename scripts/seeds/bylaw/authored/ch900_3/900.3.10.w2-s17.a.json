"rows": {
"900.3.10(936)": {"explanation": "Exception RD 936 keeps the lot frontage and lot area the lot had when the by-law was enacted, sets front setbacks of 7.5 m next to Huntingwood Dr. and 6.0 m elsewhere, 1.2 m side setbacks (4.5 m next to a street), a 0.3 m garage setback from a side lot line that does not abut a street, and requires the parking space inside the residential building. It also pulls in exception 900.3.10(1462), and gives 35 Tamora Ct. special setbacks if a detached house existed on the enactment date.", "code_refs": "none"},
"900.3.10(1156)": {"explanation": "Exception RD 1156 keeps the lot frontage and lot area the lot had when the by-law was enacted, sets front setbacks of 9.0 m next to Lawson Rd. or Centennial Rd. and 6.0 m elsewhere, 1.2 m side setbacks (4.5 m next to a street), a 0.3 m attached garage setback from a side lot line that does not abut a street, and requires the parking space inside the residential building. It also pulls in exception 900.3.10(1462).", "code_refs": "none"}
