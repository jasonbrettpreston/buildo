 "rows": {
  "900.3.10(350)": {
   "explanation": "Exception RD 350 sets site-specific setbacks (4.5 m front, 0.3 m side, 1.5 m street side; 19.0 m from the street centreline on four named streets), plus special rules for 195 Danforth Rd. and 46 Scotia Avenue. No prevailing by-laws apply.",
   "code_refs": "none"
  },
  "900.3.10(541)": {
   "explanation": "Exception RD 541 keeps the existing lot frontage as the minimum, caps lot coverage at 50 percent, sets a 3.0 m street setback, a 6.0 m setback for garage entrances facing the street, a 1.0 m side setback on one side only, and requires the parking space to be in a building. No prevailing by-laws apply.",
   "code_refs": "none"
  }
 }
