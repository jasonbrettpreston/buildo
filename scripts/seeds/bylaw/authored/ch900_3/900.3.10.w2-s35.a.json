"rows": {
"900.3.10(1345)": {"explanation":"For this RD site, an addition above the first storey of a lawfully existing detached house must meet the minimum setbacks, and a platform higher than the first floor may not encroach into the front or rear yard setback.","code_refs":"none"},
"900.3.10(272)": {"explanation":"For this RD site, the minimum setbacks are 9.0 m from the front lot line, 0.9 m from a side lot line and 2.4 m from a side lot line on a street; garages keep 0.3 m from an interior side lot line; the Midland Ave. frontage is set back 22.0 m from the original centreline; and exception 1462 also applies.","code_refs":"none"},
"900.3.10(331)": {"explanation":"For this RD site, the minimum lot frontage and lot area are those that existed on the enactment day; the front setback is 3.0 m and the main wall with parking access is 6.0 m back; the required parking space is in the residential building; lot coverage is at most 50 percent; the rear setback is 6.0 m (3.0 m where the rear lot line abuts Sheppard Ave.); and exception 1462 also applies.","code_refs":"none"}
}
