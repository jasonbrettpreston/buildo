"rows": {
"900.3.10(929)": {"explanation":"Exception RD 929 sets a 9.0 m minimum front setback, 0.9 m side setback, 4.5 m setback on a side lot line that abuts a street, and a 0.3 m garage setback from a side lot line that does not abut a street. It also brings in exception 900.3.10(1462). Two named lots, 145 and 147 Earlton Dr., have a 7.5 m front yard setback instead; that is not evaluated automatically.","code_refs":"none"},
"900.3.10(415)": {"explanation":"Exception RD 415 sets the minimum lot frontage and lot area at what existed on the day of the enactment of By-law 569-2013, a 1.2 m side setback and a 5.7 m setback on a side lot line that abuts a street. The front setback of 30.0 m from the original street centreline, for lots on Ellesmere Rd., Lawrence Ave. and Markham Rd., is not evaluated automatically.","code_refs":"none"},
"900.3.10(1120)": {"explanation":"Exception RD 1120 sets the minimum lot frontage and lot area at what existed on the date of the enactment of By-law 569-2013. Street-facing lot lines need 9.0 m where they abut Kennedy Rd. or Finch Ave. and 6.0 m otherwise; side setbacks are 1.2 m, or 5.7 m on a street side. A garage must be 0.3 m from a side lot line, and an ancillary building must be 0.9 m from a rear lot line and 0.6 m from a side lot line. It also brings in exception 900.3.10(1462). The 3.0 m distance from a residential building on the lot is not evaluated automatically.","code_refs":"none"}
}
}
