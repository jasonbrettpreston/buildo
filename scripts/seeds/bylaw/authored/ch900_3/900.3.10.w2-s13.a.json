  "rows": {
    "900.3.10(275)": {
      "explanation": "Exception RD 275 sets site-specific rules for these lands: lot frontage and lot area stay at what existed when By-law 569-2013 was enacted, side setbacks are 1.2 m (4.5 m on a street side), the required parking space must be inside the residential building, garages sit at least 0.3 m from a non-street side lot line, a 22.0 m setback applies from the original centreline of Midland Ave., and exception 1462 also applies.",
      "code_refs": "none"
    }
