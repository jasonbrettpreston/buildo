  "10.60.20.40(1)": {
   "explanation": "In the RT zone, homes are permitted in detached and semi-detached houses, townhouses, and detached and semi-detached houseplexes; apartment buildings are permitted only on a lot that abuts a major street.",
   "code_refs": "none"
  },
  "10.60.20.40(2)": {
   "explanation": "Even where a site-specific exception would say otherwise, a houseplex, townhouse or apartment building is permitted in the RT zone if it meets the RT rules or gets a minor variance.",
