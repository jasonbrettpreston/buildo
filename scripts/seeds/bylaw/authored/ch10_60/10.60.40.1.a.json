  "rows": {
    "10.60.40.1(1)": {
      "explanation": "The building rules in Article 10.60.40 apply to main buildings in the RT zone; ancillary buildings such as garages and sheds follow Article 10.5.60.",
      "code_refs": "none"
    },
    "10.60.40.1(2)": {
      "explanation": "In the RT zone, the u number in the zone label caps the dwelling units on a lot; an apartment building on a major street may have at least 60 units.",
      "code_refs": "none"
    },
    "10.60.40.1(3)": {
      "explanation": "In the RT zone, each townhouse unit must be at least 6.0 m wide, or 5.0 m if it has no private driveway of its own leading to its front.",
      "code_refs": "none"
    },
    "10.60.40.1(4)": {
      "explanation": "Where a houseplex is the only home on a lot with a site-specific (Chapter 900) exception, it follows the exception's building rules for a detached house or for one half of a semi-detached house.",
      "code_refs": "none"
    },
    "10.60.40.1(5)": {
      "explanation": "If the regular RT zone height or density rule for a houseplex is more generous than the exception's rule, the more generous rule applies.",
      "code_refs": "none"
    },
    "10.60.40.1(6)": {
      "explanation": "In the RT zone, a houseplex may have up to four bedrooms per unit with two units, or three per unit with three or more units; a bachelor unit counts as one bedroom.",
      "code_refs": "none"
    },
    "10.60.40.1(7)": {
      "explanation": "Houseplexes that existed, or had approvals or applications filed by June 26, 2025, may keep more bedrooms than the limit, but may not add more.",
      "code_refs": "none"
    },
    "10.60.40.1(8)": {
      "explanation": "Defines lawfully existing and the various complete applications used by the June 26, 2025 bedroom transition rule.",
      "code_refs": "none"
    }
  }
}
