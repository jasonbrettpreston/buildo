 "rows": {"1.40.50(1)": {"explanation": "The only zone in the Commercial Residential Employment Zone category is Commercial Residential Employment (CRE).", "code_refs": "none"}, "1.40.50(2)": {"explanation": "The Commercial Residential Employment Zone category permits uses linked to the Official Plan Regeneration Areas designation: commercial, residential, light industrial and institutional uses, and parks.", "code_refs": "none"}, "1.40.50(3)": {"explanation": "The CRE zone provides areas for a range of retail, service commercial, office, residential and limited industrial uses in single and multiple use buildings.", "code_refs": "none"}}}
