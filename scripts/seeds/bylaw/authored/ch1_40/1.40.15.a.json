 "rows": {"1.40.15(1)": {"explanation": "The zones in the Residential Apartment Zone category are Residential Apartment (RA) and Residential Apartment Commercial (RAC).", "code_refs": "none"}, "1.40.15(2)": {"explanation": "The Residential Apartment Zone category is for uses linked to the Official Plan Apartment Neighbourhoods designation: apartment buildings, parks, local institutions and small scale retail.", "code_refs": "none"}, "1.40.15(3)": {"explanation": "The RA zone provides areas for apartment buildings (and, by tribunal order, townhouses as infill); the RAC zone provides areas for apartment buildings with local institutions, small scale retail and townhouses as infill.", "code_refs": "none"}}}
