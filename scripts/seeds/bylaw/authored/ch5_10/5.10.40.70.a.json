    },
    "5.10.40.70(2)": {
      "explanation": "Building setback requirements apply only to the parts of a building or structure that are above ground.",
      "code_refs": "none"
    },
    "5.10.40.70(3)": {
      "explanation": "If one building sits on more than one lot, the required setbacks are measured from the outer boundary of the combined lots to the building's main walls.",
      "code_refs": "none"
    },
    "5.10.40.70(4)": {
      "explanation": "A use outside any building must keep the same setbacks as a building, except landscaping or horticultural uses, parks and outdoor recreation uses, and cases where another regulation sets a different setback.",
      "code_refs": "none"
    },
    "5.10.40.70(5)": {
      "explanation": "On a triangular lot with no rear lot line, the rear yard setback is measured as a radius from the point where the two side lot lines meet.",
      "code_refs": "none"
    },
    "5.10.40.70(6)": {
      "explanation": "On Toronto and Region Conservation Authority lands where a shoreline hazard limit or stable top-of-bank crosses a lot, buildings must be set back at least 10 metres from that line. Ancillary buildings on residential lots and conservation works, public utilities and transportation uses are exempt.",
      "code_refs": "none"
    },
    "5.10.40.70(7)": {
      "explanation": "A lawfully existing building already closer than the required setback to a shoreline hazard limit or stable top-of-bank may stay. It may be altered or replaced on the same lot if it is no closer to the line at any point along its main walls.",
      "code_refs": "none"
