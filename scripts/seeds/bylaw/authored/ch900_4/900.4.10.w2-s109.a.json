 "rows": {
  "900.4.10(115)": {
   "explanation": "Exception RS 115 allows at most two dwelling units per lot, keeps the lot frontage and lot area at what existed on the enactment day, and sets side setbacks of 2.4 m (4.5 m on a street side) and 0.3 m for a garage.",
   "code_refs": "none"
  },
  "900.4.10(281)": {
   "explanation": "Exception RS 281 keeps lot frontage and area at their enactment-day values, allows two dwelling units per lot, sets side setbacks of 1.2 m (4.5 m on a street side, 0.3 m for a garage), a 7.5 m setback along Pharmacy Ave. or Warden Ave., requires the parking space inside the residential building and incorporates exception 900.4.10(336).",
   "code_refs": "none"
  }
 }
