"rows":{
"900.4.10(202)":{"explanation":"Exception RS 202 sets site-specific rules for the lands: one semi-detached house per lot, lot frontage and area as they existed when the By-law was enacted, front setbacks of 7.5 m, 4.5 m or 6.0 m depending on the street or address, side setbacks of 0.9 m (4.5 m or 7.5 m on a street side), a 0.3 m garage side setback, 50 percent lot coverage, the required parking space inside the residential building, and compliance with exception 900.4.10(336).","code_refs":"none"},
"900.4.10(295)":{"explanation":"Exception RS 295 sets site-specific rules for the lands: lot frontage and area as they existed when the By-law was enacted, at most two dwelling units per lot, street-side setbacks of 7.5 m on Corinthian Boulevard and 6.0 m elsewhere, a 1.2 m side setback, a 4.5 m flanking side setback, a garage at least 0.3 m from a side lot line, the required parking space inside the residential building, and compliance with exception 900.4.10(336).","code_refs":"none"}
}}
