 "rows": {
  "900.4.10(255)": {
   "explanation": "Exception RS 255 sets site-specific rules for the RS-zone lands: minimum lot frontage and area equal to what existed when By-law 569-2013 was enacted, at most two dwelling units per lot on a registered plan, street setbacks of 7.5 m (Finch Ave., McCowan Rd., Middlefield Rd.) or 6.0 m (other streets), a 1.2 m side setback, 40% lot coverage, garages 0.3 m from a side lot line not abutting a street, required parking inside the residential building, and compliance with exception 900.4.10(336).",
   "code_refs": "none"
  }
 }
