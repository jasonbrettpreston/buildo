  "900.4.10(270)": {
   "explanation": "Exception RS 270 keeps the lot frontage and lot area that existed when the by-law was enacted, allows at most two dwelling units per lot on a registered plan, sets side setbacks of 1.2 m (4.5 m on a street side, 0.3 m for a garage), caps lot coverage at 40%, requires the parking space inside the residential building and brings in exception 900.4.10(336).",
   "code_refs": "none"
  },
  "900.4.10(267)": {
   "explanation": "Exception RS 267 keeps the lot frontage and lot area that existed when the by-law was enacted, allows at most two dwelling units per lot on a registered plan, sets street-side building setbacks of 7.5 m (named streets) or 6.0 m (other streets), side setbacks of 1.2 m (4.5 m on a street side, 0.3 m for a garage), caps lot coverage at 40%, requires the parking space inside the residential building and brings in exception 900.4.10(336).",
   "code_refs": "none"
  },
  "900.4.10(293)": {
