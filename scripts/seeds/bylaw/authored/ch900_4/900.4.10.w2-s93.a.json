  "rows": {
    "900.4.10(53)": {
      "explanation": "Exception RS 53 sets site-specific rules for these RS lands: a 22.0 m setback from the Birchmount Rd. road-allowance centreline, 2.4 m side yards, 3.6 m on a street side, a 0.3 m garage side setback, and minimum lot frontage and area for semi-detached (18.0 m / 613 m2 per building, 9.0 m / 306 m2 per unit) and detached houses (12 m / 464 m2). No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.4.10(87)": {
