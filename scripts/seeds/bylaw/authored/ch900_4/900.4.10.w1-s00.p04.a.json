  "rows": {
    "900.4.10(336)": {
      "explanation": "Exception RS 336 caps the floor area of a home on a sliding scale by lot size: on lots under 408 square metres, the lesser of 0.6 times the lot area or 204 square metres; on lots of 408 to 697 square metres, the lesser of 0.5 times the lot area or 279 square metres; on lots over 697 square metres, 0.4 times the lot area. No prevailing by-laws apply.",
      "code_refs": "none"
    },
    "900.4.10(312)": {
      "explanation": "Exception RS 312 lets a detached house sit on a smaller lot than the RS zone normally requires: a minimum lot area of 185 square metres and a minimum lot frontage of 6.0 metres. At 120 Donlands Avenue, City of Toronto by-law 944-2015 prevails and is not evaluated by MaxBLD.",
      "code_refs": "none"
    }
