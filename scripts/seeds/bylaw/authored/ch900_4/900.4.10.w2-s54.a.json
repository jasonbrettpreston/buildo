  "rows": {
    "900.4.10(149)": {
      "explanation": "Exception RS 149 allows one semi-detached house per lot, keeps the minimum lot frontage and lot area at what existed when the By-law was enacted, sets a 1.2 m side setback (4.5 m beside a street, 7.5 m beside the named roads) and requires garages to sit 0.3 m from a side lot line that does not abut a street.",
      "code_refs": "none"
    },
    "900.4.10(145)": {
      "explanation": "Exception RS 145 allows one semi-detached house per lot, keeps the minimum lot frontage and lot area at what existed when the By-law was enacted, sets a 1.2 m side setback (4.5 m beside a street, 7.5 m beside the named roads), caps lot coverage at 40 percent and lets a semi-detached garage sit on the common lot line, otherwise 0.3 m from side lot lines.",
      "code_refs": "none"
    }
