    "900.4.10(312)": {
      "explanation": "On the lands covered by Exception RS 312, a detached house needs a lot of at least 185 square metres with at least 6.0 metres of frontage. For 120 Donlands Avenue, former City of Toronto by-law 944-2015 is a separate alternate path that we do not evaluate.",
      "code_refs": "none"
    },
    "900.4.10(336)": {
      "explanation": "On the lands covered by Exception RS 336, the maximum floor space index depends on lot area: under 408 square metres, the lesser of 0.6 times the lot area or 204 square metres; 408 to 697 square metres, the lesser of 0.5 times the lot area or 279 square metres; over 697 square metres, 0.4 times the lot area. No prevailing by-laws apply.",
      "code_refs": "none"
