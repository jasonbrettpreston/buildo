  "900.4.10(97)": {
   "explanation": "Exception RS 97 sets the minimum lot frontage and lot area for semi-detached houses and detached houses, the front and side building setbacks, and a 50% maximum lot coverage. No prevailing by-laws apply.",
   "code_refs": "none"
  },
  "900.4.10(104)": {
   "explanation": "Exception RS 104 uses the lot frontage and lot area that existed on the day the by-law was enacted, allows at most two dwelling units per lot, sets side setbacks, a 7.5 m front setback along Bellamy Rd., requires the parking space inside the residential building, sets the attached garage side setback and a 40% maximum lot coverage.",
   "code_refs": "none"
  }
 }
