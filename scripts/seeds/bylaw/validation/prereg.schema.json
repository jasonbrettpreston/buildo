{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "bylaw-prereg-v1",
  "$comment": "McBylaw Phase 2 validation pre-registration (phase2-plan-v2 §V-4, §K.2). Committed before its round; validate-round.mjs checks its blob is the one at HEAD (prereg_status). Locked by src/tests/bylaw-validate-round.infra.test.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$comment",
    "schema",
    "round",
    "plan_ref",
    "k7r",
    "k3",
    "oracles",
    "heldout",
    "double_check",
    "db_counts",
    "k3_sources"
  ],
  "properties": {
    "$comment": {
      "type": "string"
    },
    "schema": {
      "const": "bylaw-prereg-v1"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "plan_ref": {
      "type": "string",
      "minLength": 1
    },
    "k7r": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codes_source",
        "lot_gates",
        "lot_gates_source",
        "extra_keys",
        "classes",
        "class_map",
        "keyed_scope",
        "kill",
        "probe",
        "planned_keying_source",
        "notes"
      ],
      "properties": {
        "codes_source": {
          "type": "string"
        },
        "lot_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "lot_gates_source": {
          "type": "string"
        },
        "extra_keys": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "classes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "i",
            "ii",
            "i_if_planned",
            "not_unavailable"
          ],
          "properties": {
            "i": {
              "type": "string"
            },
            "ii": {
              "type": "string"
            },
            "i_if_planned": {
              "type": "string"
            },
            "not_unavailable": {
              "type": "string"
            }
          }
        },
        "class_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "i",
              "ii",
              "i_if_planned",
              "not_unavailable"
            ]
          }
        },
        "keyed_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definition",
            "exceptions_source"
          ],
          "properties": {
            "definition": {
              "type": "string"
            },
            "exceptions_source": {
              "type": "string"
            }
          }
        },
        "kill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ii_item_max",
            "ii_lot_max",
            "i_plus_ii_max",
            "i_plus_ii_weights",
            "comparator",
            "post_hoc",
            "post_hoc_basis",
            "original_k7"
          ],
          "properties": {
            "ii_item_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ii_lot_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "i_plus_ii_max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "i_plus_ii_weights": {
              "type": "array",
              "items": {
                "enum": [
                  "item",
                  "lot"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "comparator": {
              "const": "greater_than"
            },
            "post_hoc": {
              "type": "boolean"
            },
            "post_hoc_basis": {
              "type": "string"
            },
            "original_k7": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "threshold",
                "scope",
                "weight"
              ],
              "properties": {
                "threshold": {
                  "type": "number"
                },
                "scope": {
                  "const": "all_items"
                },
                "weight": {
                  "const": "item"
                }
              }
            }
          }
        },
        "probe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "rank_from",
            "rank_to",
            "n",
            "ranks",
            "rule",
            "kill"
          ],
          "properties": {
            "seed": {
              "type": "string",
              "minLength": 8
            },
            "rank_from": {
              "type": "integer"
            },
            "rank_to": {
              "type": "integer"
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "ranks": {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "uniqueItems": true
            },
            "rule": {
              "type": "string"
            },
            "kill": {
              "type": "string"
            }
          }
        },
        "notes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "planned_keying_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "blob_sha",
            "step",
            "grain",
            "rule"
          ],
          "properties": {
            "path": {
              "const": "scripts/seeds/bylaw/w1-shards.json"
            },
            "blob_sha": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{40}$"
            },
            "step": {
              "type": "string",
              "pattern": "^P2-[0-9]+[a-z]?$"
            },
            "grain": {
              "const": "exception"
            },
            "rule": {
              "type": "string"
            }
          }
        }
      }
    },
    "k3": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "measures",
          "limits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^k3_[a-g]$"
          },
          "measures": {
            "type": "string"
          },
          "missing_sources": {
            "type": "string"
          },
          "limits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "max",
                "source"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9_]+$"
                },
                "max": {
                  "type": "number"
                },
                "source": {
                  "type": "string",
                  "minLength": 10
                }
              }
            }
          }
        }
      }
    },
    "oracles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ],
      "properties": {
        "A": {
          "$ref": "#/definitions/oracle"
        },
        "B": {
          "$ref": "#/definitions/oracle"
        },
        "C": {
          "$ref": "#/definitions/oracle"
        },
        "D": {
          "$ref": "#/definitions/oracle"
        },
        "E": {
          "$ref": "#/definitions/oracle"
        }
      }
    },
    "heldout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitment_sha256",
        "draw",
        "rule",
        "seed_custody",
        "n_per_stratum",
        "salt_env"
      ],
      "properties": {
        "commitment_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "draw": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "database",
            "strata",
            "n_per_stratum",
            "order",
            "per_stratum",
            "population_sha256",
            "validate_round_version"
          ],
          "properties": {
            "database": {
              "type": "string"
            },
            "strata": {
              "const": "zoning_class in vocab.json zone"
            },
            "n_per_stratum": {
              "type": "integer",
              "minimum": 1
            },
            "order": {
              "type": "string"
            },
            "per_stratum": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "population",
                  "drawn"
                ],
                "properties": {
                  "population": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "drawn": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "population_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "validate_round_version": {
              "type": "string"
            }
          }
        },
        "rule": {
          "type": "string"
        },
        "seed_custody": {
          "const": "operator_declared_only"
        },
        "n_per_stratum": {
          "type": "integer",
          "minimum": 1
        },
        "salt_env": {
          "const": "MCBYLAW_HELDOUT_SALT"
        }
      }
    },
    "double_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "deterministic_paths",
        "tolerance"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "deterministic_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tolerance": {
          "const": 0
        }
      }
    },
    "db_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction",
        "reads"
      ],
      "properties": {
        "transaction": {
          "const": "read_only"
        },
        "reads": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "k3_sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "definitions": {
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "what"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "what": {
          "type": "string"
        },
        "verdict": {
          "const": "not_run"
        },
        "reason": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "contract": {
          "type": "object"
        },
        "pass_rule": {
          "type": "string"
        }
      },
      "if": {
        "properties": {
          "available": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "verdict",
          "reason",
          "basis"
        ]
      }
    }
  }
}
