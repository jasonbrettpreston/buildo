  "rows": [
    {"id":"permitted","building_type":"detached_house","increment":"1","form":"status","unit":null,"reads":"permission word of the class from the stored lot row, and the lot gate","status_map":{"0":"permitted","1":"not_permitted:{clause}","2":"not_evaluated:{reason}","gate":"not_permitted:lot_gate:{gate}"},"clauses":["10.20.20.40(1)"],"rules":["M-64","M-394","M-417"],"example_ids":["PERM-1","PERM-2","PERM-3","PERM-4"],"switch":"formula:permitted"},
    {"id":"front_setback_used_m","building_type":"detached_house","increment":"1","form":"expr","unit":"m","envelope":false,"expression":"if(user_n ≥ 1 units; user_mean_m; if(nbr_q_n ≥ 1 units and nbr_q_n ≤ 2 units and nbr_q_n = nbr_all_n and nbr_q_bad_n = 0 units; nbr_q_est_mean_m + lv(fya_porch_allowance_m); if(nbr_q_n ≥ 1 units and nbr_q_n ≤ 2 units and nbr_q_n = nbr_all_n; if(ring_n ≥ lv(fya_placeholder_ring_min_n); if(own_n ≥ 1 units; (own_front_m + ring_est_mean_m) ÷ 2 ratio + lv(fya_porch_allowance_m); ring_est_mean_m + lv(fya_porch_allowance_m)); if(street_n ≥ lv(fya_placeholder_street_min_n); if(own_n ≥ 1 units; (own_front_m + street_median_m) ÷ 2 ratio + lv(fya_porch_allowance_m); street_median_m + lv(fya_porch_allowance_m)); if(own_n ≥ 1 units; own_front_m + lv(fya_porch_allowance_m); if(zone_n ≥ lv(fya_placeholder_zone_min_n); zone_median_m + lv(fya_porch_allowance_m); l2(front_setback_fallback_m))))); l2(front_setback_fallback_m))))","input_flags":{"l2(front_setback_fallback_m)":["front_yard_needs_survey"]},"clauses":["10.5.40.70(1)","x.40.70(1)"],"rules":["M-245","M-256","M-387","M-412","FS-SB1","FS-SB2","M-414","L31-03","FS-SB2a"],"example_ids":["FY-1","FY-2","FY-3","FY-4","FY-5","FY-6","FY-7","FY-8","FY-9","FY-10","FY-11","FY-12","FY-13","FY-14","FY-15"],"switch":"formula:front_setback_used_m"},
    {"id":"depth_room_m","building_type":"detached_house","increment":"1","form":"expr","unit":"m","envelope":true,"expression":"lot_depth_m − front_setback_used_m − l2(rear_setback_m)","clauses":["10.20.40.70(1)","10.20.40.70(2)"],"rules":["M-72","M-413"],"example_ids":["FOOT-1","FOOT-13","FOOT-14"],"switch":"formula:depth_room_m"},
    {"id":"buildable_width_m","building_type":"detached_house","increment":"1","form":"expr","unit":"m","envelope":true,"expression":"lot_frontage_m − l2(side_setback_m) − if(holds(corner_lot); l2(side_setback_street_m); l2(side_setback_m))","clauses":["10.20.40.70(3)","10.20.40.70(6)"],"rules":["M-72","M-412","M-421"],"example_ids":["FOOT-1","FOOT-9","FOOT-11","FOOT-12"],"switch":"formula:buildable_width_m"},
    {"id":"buildable_depth_m","building_type":"detached_house","increment":"1","form":"expr","unit":"m","envelope":true,"expression":"min(depth_room_m; l2(building_depth_m); l2(building_length_m))","clauses":["10.20.40.70(1)"],"rules":["M-205","M-413"],"example_ids":["FOOT-4","FOOT-5","FOOT-6","FOOT-7","FOOT-8","FOOT-15"],"switch":"formula:buildable_depth_m"},
    {"id":"footprint_max_m2","building_type":"detached_house","increment":"1","form":"expr","unit":"m2","envelope":true,"expression":"min(buildable_width_m × buildable_depth_m; l2(lot_coverage_pct) × lot_area_m2) × lv(footprint_shape_factor)","clauses":["10.20.30.40(1)","10.20.40.70(1)"],"rules":["G-1","LC-69","M-72","M-385","M-386","M-392"],"example_ids":["FOOT-1","FOOT-2","FOOT-3","FOOT-4","FOOT-5","FOOT-6","FOOT-7","FOOT-8","FOOT-9","FOOT-10","FOOT-11","FOOT-12","FOOT-13","FOOT-14","FOOT-15","FOOT-16","FOOT-17","FOOT-18"],"switch":"formula:footprint_max_m2","status_map":{"setting_not_fitted:footprint_shape_factor":"shape_factor_not_fitted"}},
    {"id":"height_max_m","building_type":"detached_house","increment":"1","form":"expr","unit":"m","envelope":false,"expression":"l2(height_m)","clauses":["10.20.40.10(1)"],"rules":["M-61"],"example_ids":["HT-1","HT-2","HT-3"],"switch":"formula:height_max_m"},
    {"id":"storeys_max","building_type":"detached_house","increment":"1","form":"expr","unit":"storeys","envelope":true,"expression":"if(regulated(height_storeys); l2(height_storeys); floor((l2(height_m) − lv(s2_first_floor_above_grade_m) − (lv(s1_floor_assembly_m) + lv(s1_parapet_m))) ÷ (lv(s1_ceiling_min_m) + lv(s1_floor_assembly_m))))","clauses":["10.20.40.10(3)"],"rules":["M-391","M-399","M-404","M-405","M-419","R3-08"],"example_ids":["ST-1","ST-2","ST-3","ST-4","ST-5","ST-6","ST-7","ST-8","ST-9","ST-10"],"switch":"formula:storeys_max","terminal":"refuse","input_flags":{"lv(s1_ceiling_min_m)":["storeys_from_minimum_ceiling"],"lv(s1_floor_assembly_m)":["storeys_from_minimum_ceiling"],"lv(s1_parapet_m)":["storeys_from_minimum_ceiling"]}},
    {"id":"gfa_max_m2","building_type":"detached_house","increment":"1","form":"expr","unit":"m2","envelope":true,"expression":"min(footprint_max_m2 × storeys_max; l2(fsi) × lot_area_m2; l2(gfa_m2))","clauses":["10.20.40.40(1)"],"rules":["M-72","M-385","M-419","M-420"],"example_ids":["GFA-1","GFA-2","GFA-3","GFA-4","GFA-5","GFA-6","GFA-7","GFA-8","GFA-9"],"switch":"formula:gfa_max_m2","optional_targets":["gfa_m2"]},
    {"id":"units_max","building_type":"detached_house","increment":"1","form":"expr","unit":"units","envelope":false,"expression":"min(bt_units; l2(dwelling_units_max))","clauses":["M-202(3) as stored"],"rules":["M-202","M-72"],"example_ids":["UN-1","UN-2","UN-3","UN-4"],"switch":"formula:units_max"}
  ]
