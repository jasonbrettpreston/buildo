    {"id":"footprint_shape_factor","unit":"ratio","citation":"LC-69 (131:119)","rules":["LC-69","M-392"],"switch":"reading:shape_calibration","flags_off":["shape_box_assumed"],"flags_on":["shape_calibrated"],"provenance_required_when_on":true}
